      ],
      "grammatik": {
        "titel": "Akkusativ = DAS bestimmte Ding",
        "erklaerung": [
          "Wenn du ein bestimmtes Ding meinst (das Brot da), bekommt es -ı/-i/-u/-ü: Ekmeği uzatır mısın?",
          "Ohne Endung heißt es „irgendein“: Ekmek istiyorum. – mit Endung „genau das“: Ekmeği istiyorum.",
          "Nach Vokal kommt y: Amani → Amani'yi, çay → çayı (y ist hier Teil des Wortes).",
          "k wird wieder ğ: ekmek → ekmeği. Ausnahme: su → suyu."
        ],
        "tabelle": {
          "kopf": ["Ding", "das Ding (Akk.)"],
          "zeilen": [
            ["ekmek", "ekmeği"],
            ["peynir", "peyniri"],
            ["tuz", "tuzu"],
            ["su", "suyu"],
            ["çatal", "çatalı"],
            ["Amani", "Amani'yi"]
          ]
        },
        "beispiele": [
          { "tr": "Tuzu uzatır mısın?", "de": "Reichst du mir mal das Salz?" },
          { "tr": "Ekmeği sen alıyor musun?", "de": "Holst du das Brot?" },
          { "tr": "Amani'yi görüyor musun?", "de": "Siehst du Amani?" }
        ]
      },
      "dialog": {
        "titel": "Am Esstisch",
        "zeilen": [
          { "sprecher": "Pasha", "tr": "Tuzu uzatır mısın?", "de": "Reichst du mir mal das Salz?" },
          { "sprecher": "Sherin", "tr": "Tabii. Ekmeği de istiyor musun?", "de": "Klar. Willst du das Brot auch?" },
          { "sprecher": "Pasha", "tr": "Evet, lütfen. Peyniri de.", "de": "Ja, bitte. Und den Käse." },
          { "sprecher": "Sherin", "tr": "Inaya, çatalı bırak!", "de": "Inaya, lass die Gabel los!" },
          { "sprecher": "Pasha", "tr": "Kaşığı ver ona.", "de": "Gib ihr den Löffel." },
          { "sprecher": "Sherin", "tr": "Al canım, kaşığın burada.", "de": "Hier, Schatz, dein Löffel." }
        ]
      },
      "uebungen": [
        { "art": "zuordnen", "vokabeln": ["w06-tuz", "w06-seker", "w06-bicak", "w06-catal"] },
        { "art": "luecke", "satz": "Tuz___ uzatır mısın?", "loesung": "u", "optionen": ["u", "ı", "yu"], "de": "Reichst du mir mal das Salz?" },
        { "art": "luecke", "satz": "Ekme___ sen alıyor musun?", "loesung": "ği", "optionen": ["ği", "ki", "kı"], "de": "Holst du das Brot?", "hinweis": "k wird zu ğ" },
