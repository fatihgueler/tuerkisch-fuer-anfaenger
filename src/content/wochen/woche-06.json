      ],
      "grammatik": {
        "titel": "Ich möchte … = … istiyorum",
        "erklaerung": [
          "„Ich möchte“ ist istiyorum, das Ding steht davor: Su istiyorum. = Ich möchte Wasser.",
          "Bei „irgendein / etwas“ bekommt das Ding keine Endung: Ekmek istiyorum. = Ich möchte (irgendein) Brot.",
          "Mengen kommen vor das Ding: iki yumurta, bir bardak su."
        ],
        "beispiele": [
          { "tr": "Su istiyorum.", "de": "Ich möchte Wasser." },
          { "tr": "Inaya elma istiyor.", "de": "Inaya möchte einen Apfel." },
          { "tr": "Peynir istiyor musun?", "de": "Möchtest du Käse?" }
        ]
      },
      "dialog": {
        "titel": "Samstagsfrühstück",
        "zeilen": [
          { "sprecher": "Pasha", "tr": "Kahvaltı hazır! Ne istiyorsun?", "de": "Frühstück ist fertig! Was möchtest du?" },
          { "sprecher": "Sherin", "tr": "Ekmek, peynir ve zeytin.", "de": "Brot, Käse und Oliven." },
          { "sprecher": "Pasha", "tr": "Yumurta istiyor musun?", "de": "Möchtest du ein Ei?" },
          { "sprecher": "Sherin", "tr": "Evet, bir yumurta lütfen.", "de": "Ja, ein Ei bitte." },
          { "sprecher": "Pasha", "tr": "Inaya ne istiyor?", "de": "Was möchte Inaya?" },
          { "sprecher": "Sherin", "tr": "Inaya elma ve süt istiyor.", "de": "Inaya möchte Apfel und Milch." }
        ]
      },
      "uebungen": [
        { "art": "zuordnen", "vokabeln": ["w06-ekmek", "w06-sut", "w06-peynir", "w06-yumurta", "w06-su"] },
        { "art": "auswahl_de_tr", "vokabel": "w06-zeytin" },
        { "art": "hoeren", "vokabel": "w06-domates" },
        { "art": "satzbau", "tr": "Bir bardak su, lütfen.", "de": "Ein Glas Wasser, bitte." },
        { "art": "auswahl_tr_de", "vokabel": "w06-tavuk" },
        { "art": "luecke", "satz": "Su ___.", "loesung": "istiyorum", "optionen": ["istiyorum", "istemek", "istiyor"], "de": "Ich möchte Wasser." },
        { "art": "hoeren", "vokabel": "w06-elma" },
        { "art": "tippen", "vokabel": "w06-sut" },
        { "art": "satzbau", "tr": "Inaya elma ve süt istiyor.", "de": "Inaya möchte Apfel und Milch." }
      ],
      "sprechauftrag": {
        "aufgabe": "Deckt zusammen den Frühstückstisch – nur auf Türkisch. Jeder sagt, was er möchte; du sagst auch, was Inaya möchte.",
        "mustersaetze": [
          { "tr": "Ben peynir ve zeytin istiyorum.", "de": "Ich möchte Käse und Oliven." },
          { "tr": "Inaya süt istiyor.", "de": "Inaya möchte Milch." },
          { "tr": "Sen ne istiyorsun?", "de": "Was möchtest du?" }
        ]
      },
      "alltagssatz": { "tr": "Su istiyorum.", "de": "Ich möchte Wasser.", "wann": "Beim nächsten Durst – sag es Pasha auf Türkisch." },
      "merktipp": { "titel": "Türkisches Frühstück", "text": "Ein typisches kahvaltı: ekmek, beyaz peynir, zeytin, domates, yumurta und Tee. Wenn du die Wörter kennst, kannst du jedes Frühstück bei Pashas Familie benennen." }
    },
    {
