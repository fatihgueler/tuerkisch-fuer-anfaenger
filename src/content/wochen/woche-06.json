        { "art": "satzbau", "tr": "Kaşığı ver ona.", "de": "Gib ihr den Löffel." },
        { "art": "auswahl_tr_de", "vokabel": "w06-almak" },
        { "art": "tippen", "vokabel": "w06-tuz" },
        { "art": "hoeren", "vokabel": "w06-pecete" }
