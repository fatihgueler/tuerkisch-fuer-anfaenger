          "de": "Wir sind zu Hause, weil es kalt ist."
        },
        {
          "art": "luecke",
          "satz": "Hava soğuk, ___ evdeyiz.",
          "loesung": "bu yüzden",
          "optionen": [
            "bu yüzden",
            "çünkü",
            "ama"
          ],
          "de": "Es ist kalt, deshalb sind wir zu Hause."
        },
        {
          "art": "hoeren",
          "vokabel": "w15-hem-hem-de"
        },
        {
          "art": "auswahl_de_tr",
          "vokabel": "w15-ne-ne-de"
        },
        {
          "art": "satzbau",
          "tr": "Yorgunum ama yine de çalışıyorum.",
          "de": "Ich bin müde, aber ich lerne trotzdem."
        },
        {
          "art": "auswahl_tr_de",
          "vokabel": "w15-sebep"
        },
        {
          "art": "hoeren",
          "vokabel": "w15-mesela"
        },
        {
          "art": "tippen",
          "vokabel": "w15-cunku"
        }
      ],
      "sprechauftrag": {
        "aufgabe": "„Warum?“-Spiel: Pasha fragt zehnmal „Neden?“ zu deinem Alltag (Warum bist du müde? Warum lernst du Türkisch? …). Du antwortest immer mit çünkü.",
        "mustersaetze": [
          {
            "tr": "Neden Türkçe öğreniyorsun? – Çünkü seni ve aileni anlamak istiyorum.",
            "de": "Warum lernst du Türkisch? – Weil ich dich und deine Familie verstehen will."
          },
          {
            "tr": "Yorgunum çünkü …",
            "de": "Ich bin müde, weil …"
          },
          {
            "tr": "… bu yüzden …",
            "de": "… deshalb …"
          }
        ]
      },
      "alltagssatz": {
        "tr": "Çünkü seni anlamak istiyorum.",
        "de": "Weil ich dich verstehen will.",
        "wann": "Wenn jemand aus Pashas Familie fragt, warum du Türkisch lernst."
      },
      "merktipp": {
        "titel": "Weil – ohne Wortsalat",
        "text": "Im Deutschen wirft „weil“ das Verb ans Ende. Im Türkischen steht das Verb sowieso immer am Ende – çünkü ändert gar nichts. Einfacher geht's nicht."
      }
    },
