{
  "woche": 15,
  "lektionen": [
    {
      "woche": 15,
      "tag": 1,
      "titel": "Wie fühlst du dich?",
      "kannZiel": "Gefühle benennen",
      "vokabeln": [
        {
          "id": "w15-uzgun",
          "tr": "üzgün",
          "de": "traurig",
          "typ": "wort",
          "beispiel": {
            "tr": "Neden üzgünsün?",
            "de": "Warum bist du traurig?"
          }
        },
        {
          "id": "w15-sinirli",
          "tr": "sinirli",
          "de": "wütend / gereizt",
          "typ": "wort",
          "beispiel": {
            "tr": "Bugün biraz sinirliyim.",
            "de": "Heute bin ich etwas gereizt."
          }
        },
        {
          "id": "w15-endiseli",
          "tr": "endişeli",
          "de": "besorgt",
          "typ": "wort",
          "beispiel": {
            "tr": "Inaya hasta, çok endişeliyim.",
            "de": "Inaya ist krank, ich bin sehr besorgt."
          }
        },
        {
          "id": "w15-saskin",
          "tr": "şaşkın",
          "de": "überrascht / verdutzt",
          "typ": "wort",
          "beispiel": {
            "tr": "Pasha çok şaşkındı.",
            "de": "Pasha war total verdutzt."
          }
        },
        {
          "id": "w15-gururlu",
          "tr": "gururlu",
          "de": "stolz",
          "typ": "wort",
          "beispiel": {
            "tr": "Seninle gurur duyuyorum.",
            "de": "Ich bin stolz auf dich."
          }
        },
        {
          "id": "w15-kiskanc",
          "tr": "kıskanç",
          "de": "eifersüchtig",
          "typ": "wort",
          "beispiel": {
            "tr": "Amani biraz kıskanç, Inaya'yı kıskanıyor.",
            "de": "Amani ist ein bisschen eifersüchtig, sie ist eifersüchtig auf Inaya."
          }
        },
        {
          "id": "w15-canim-sikkin",
          "tr": "Canım sıkkın.",
          "de": "Ich bin bedrückt / genervt.",
          "typ": "chunk",
          "beispiel": {
            "tr": "Bugün canım biraz sıkkın.",
            "de": "Heute bin ich etwas bedrückt."
          }
        },
        {
          "id": "w15-rahatladim",
          "tr": "Rahatladım.",
          "de": "Ich bin erleichtert.",
          "typ": "chunk",
          "beispiel": {
            "tr": "Ateşi düştü, çok rahatladım.",
            "de": "Das Fieber ist runter, ich bin so erleichtert."
          }
        },
        {
          "id": "w15-korkuyorum",
          "tr": "Korkuyorum.",
          "de": "Ich habe Angst.",
          "typ": "chunk",
          "beispiel": {
            "tr": "Köpeklerden korkuyor musun?",
            "de": "Hast du Angst vor Hunden?"
          }
        }
      ],
      "grammatik": {
        "titel": "Gefühle mit „sein“",
        "erklaerung": [
          "Gefühle sind meist Adjektive + „sein“-Endung: üzgünüm, sinirlisin, endişeliyiz.",
          "„war“: üzgündüm, sinirliydi. Frage: Üzgün müsün?",
          "Angst vor etwas: -dan/-den korkmak: Köpeklerden korkuyor. (Hat Angst vor Hunden.)"
        ],
        "tabelle": {
          "kopf": [
            "",
            "jetzt",
            "vorhin"
          ],
          "zeilen": [
            [
              "ich",
              "üzgünüm",
              "üzgündüm"
            ],
            [
              "du",
              "üzgünsün",
              "üzgündün"
            ],
            [
              "er/sie",
              "üzgün",
              "üzgündü"
            ]
          ]
        },
        "beispiele": [
          {
            "tr": "Neden üzgünsün?",
            "de": "Warum bist du traurig?"
          },
          {
            "tr": "Dün çok sinirliydim, özür dilerim.",
            "de": "Gestern war ich sehr gereizt, tut mir leid."
          },
          {
            "tr": "Seninle gurur duyuyorum.",
            "de": "Ich bin stolz auf dich."
          }
        ]
      },
      "dialog": {
        "titel": "Ein schwerer Tag",
        "zeilen": [
          {
            "sprecher": "Pasha",
            "tr": "Ne oldu canım? Üzgün görünüyorsun.",
            "de": "Was ist los, Schatz? Du siehst traurig aus."
          },
          {
            "sprecher": "Sherin",
            "tr": "Canım biraz sıkkın. Inaya bütün gün ağladı.",
            "de": "Ich bin etwas bedrückt. Inaya hat den ganzen Tag geweint."
          },
          {
            "sprecher": "Pasha",
            "tr": "Hasta mı? Endişeli misin?",
            "de": "Ist sie krank? Machst du dir Sorgen?"
          },
          {
            "sprecher": "Sherin",
            "tr": "Biraz. Ama ateşi yok. Galiba sadece diş.",
            "de": "Ein bisschen. Aber sie hat kein Fieber. Wahrscheinlich nur ein Zahn."
          },
          {
            "sprecher": "Pasha",
            "tr": "Tamam, rahatladım. Bu akşam ben ona bakarım.",
            "de": "Okay, da bin ich erleichtert. Heute Abend kümmere ich mich um sie."
          },
          {
            "sprecher": "Sherin",
            "tr": "Teşekkürler. Seninle gurur duyuyorum, biliyor musun?",
            "de": "Danke. Ich bin stolz auf dich, weißt du das?"
          }
        ]
      },
      "uebungen": [
        {
          "art": "zuordnen",
          "vokabeln": [
            "w15-uzgun",
            "w15-sinirli",
            "w15-endiseli",
            "w15-gururlu"
          ]
        },
        {
          "art": "luecke",
          "satz": "Neden üzgün___?",
          "loesung": "sün",
          "optionen": [
            "sün",
            "sin",
            "sun"
          ],
          "de": "Warum bist du traurig?"
        },
        {
          "art": "luecke",
          "satz": "Dün çok sinirli___.",
          "loesung": "ydim",
          "optionen": [
            "ydim",
            "dim",
            "yim"
          ],
          "de": "Gestern war ich sehr gereizt."
        },
        {
          "art": "hoeren",
          "vokabel": "w15-rahatladim"
        },
        {
          "art": "auswahl_de_tr",
          "vokabel": "w15-canim-sikkin"
        },
        {
          "art": "satzbau",
          "tr": "Köpeklerden korkuyor musun?",
          "de": "Hast du Angst vor Hunden?"
        },
        {
          "art": "auswahl_tr_de",
          "vokabel": "w15-kiskanc"
        },
        {
          "art": "hoeren",
          "vokabel": "w15-saskin"
        },
        {
          "art": "tippen",
          "vokabel": "w15-uzgun"
        },
        {
          "art": "auswahl_de_tr",
          "vokabel": "w01-mutlu"
        }
      ],
      "sprechauftrag": {
        "aufgabe": "Gefühls-Barometer: Fragt euch heute dreimal (morgens, mittags, abends) auf Türkisch, wie ihr euch fühlt – und antwortet mit einem Gefühl und einem kurzen Grund.",
        "mustersaetze": [
          {
            "tr": "Nasıl hissediyorsun?",
            "de": "Wie fühlst du dich?"
          },
          {
            "tr": "Biraz yorgunum ama mutluyum.",
            "de": "Ich bin etwas müde, aber glücklich."
          },
          {
            "tr": "Canım sıkkın.",
            "de": "Ich bin bedrückt."
          }
        ]
      },
      "alltagssatz": {
        "tr": "Seninle gurur duyuyorum.",
        "de": "Ich bin stolz auf dich.",
        "wann": "Zu Inaya, wenn sie etwas Neues schafft – oder zu Pasha."
      },
      "merktipp": {
        "titel": "can – die Seele",
        "text": "can (Seele/Leben) steckt in vielen Gefühlen: Canım sıkkın (meine Seele ist eng = ich bin bedrückt), Canım istiyor (ich hab Lust), canım (mein Schatz)."
      }
    },
    {
      "woche": 15,
      "tag": 2,
      "titel": "Weil … : çünkü",
      "kannZiel": "Gründe nennen",
      "vokabeln": [
        {
          "id": "w15-cunku",
          "tr": "çünkü",
          "de": "weil / denn",
          "typ": "wort",
          "beispiel": {
            "tr": "Yorgunum çünkü Inaya gece uyanıyor.",
            "de": "Ich bin müde, weil Inaya nachts aufwacht."
          }
        },
        {
          "id": "w15-bu-yuzden",
          "tr": "bu yüzden",
          "de": "deshalb",
          "typ": "chunk",
          "beispiel": {
            "tr": "Hava soğuk, bu yüzden evdeyiz.",
            "de": "Es ist kalt, deshalb sind wir zu Hause."
          }
        },
        {
          "id": "w15-yine-de",
          "tr": "yine de",
          "de": "trotzdem",
          "typ": "chunk",
          "beispiel": {
            "tr": "Yorgunum ama yine de çalışıyorum.",
            "de": "Ich bin müde, aber ich lerne trotzdem."
          }
        },
        {
          "id": "w15-hem-hem-de",
          "tr": "hem … hem de …",
          "de": "sowohl … als auch …",
          "typ": "chunk",
          "beispiel": {
            "tr": "Hem yorgunum hem de açım.",
            "de": "Ich bin müde und hungrig zugleich."
          }
        },
        {
          "id": "w15-ne-ne-de",
          "tr": "ne … ne de …",
          "de": "weder … noch …",
          "typ": "chunk",
          "beispiel": {
            "tr": "Ne çay var ne de kahve!",
            "de": "Es gibt weder Tee noch Kaffee!"
          }
        },
        {
          "id": "w15-sebep",
          "tr": "sebep",
          "de": "Grund",
          "typ": "wort",
          "beispiel": {
            "tr": "Sebebi ne?",
            "de": "Was ist der Grund?"
          }
        },
        {
          "id": "w15-ayrica",
          "tr": "ayrıca",
          "de": "außerdem",
          "typ": "wort",
          "beispiel": {
            "tr": "Ayrıca yarın doktor var.",
            "de": "Außerdem ist morgen Arzt."
          }
        },
        {
          "id": "w15-mesela",
          "tr": "mesela",
          "de": "zum Beispiel",
          "typ": "wort",
          "beispiel": {
            "tr": "Mesela yarın parka gidebiliriz.",
            "de": "Zum Beispiel könnten wir morgen in den Park gehen."
          }
        }
      ],
      "grammatik": {
        "titel": "çünkü & bu yüzden",
        "erklaerung": [
          "çünkü verbindet zwei ganze Sätze – das Verb bleibt in beiden am Ende: Evdeyim çünkü hastayım.",
          "Andersrum mit bu yüzden (deshalb): Hastayım, bu yüzden evdeyim.",
          "Kurze Antwort auf „Neden?“: Çünkü … – genau wie im Deutschen „Weil …“."
        ],
        "tabelle": {
          "kopf": [
            "Grund → Folge",
            "Folge ← Grund"
          ],
          "zeilen": [
            [
              "Hava soğuk, bu yüzden evdeyiz.",
              "Evdeyiz çünkü hava soğuk."
            ],
            [
              "Açım, bu yüzden yemek yapıyorum.",
              "Yemek yapıyorum çünkü açım."
            ]
          ]
        },
        "beispiele": [
          {
            "tr": "Neden gelmedin? – Çünkü Inaya hastaydı.",
            "de": "Warum bist du nicht gekommen? – Weil Inaya krank war."
          },
          {
            "tr": "Yorgunum ama yine de çalışıyorum.",
            "de": "Ich bin müde, aber ich lerne trotzdem."
          },
          {
            "tr": "Ne çay var ne de kahve!",
            "de": "Es gibt weder Tee noch Kaffee!"
          }
        ]
      },
      "dialog": {
        "titel": "Absage an Elif",
        "zeilen": [
          {
            "sprecher": "Elif",
            "tr": "Cumartesi neden gelmedin?",
            "de": "Warum bist du am Samstag nicht gekommen?"
          },
          {
            "sprecher": "Sherin",
            "tr": "Özür dilerim, çünkü Inaya hastaydı.",
            "de": "Tut mir leid, weil Inaya krank war."
          },
          {
            "sprecher": "Elif",
            "tr": "Geçmiş olsun! Şimdi nasıl?",
            "de": "Gute Besserung! Wie geht's ihr jetzt?"
          },
          {
            "sprecher": "Sherin",
            "tr": "İyi. Ama ben hem yorgunum hem de hastalandım.",
            "de": "Gut. Aber ich bin müde und jetzt auch krank geworden."
          },
          {
            "sprecher": "Elif",
            "tr": "Ay, o zaman bu hafta dinlen. Ayrıca bir şey lazım mı?",
            "de": "Oh, dann ruh dich diese Woche aus. Brauchst du außerdem was?"
          },
          {
            "sprecher": "Sherin",
            "tr": "Yok, teşekkürler. Ama yine de gelecek hafta buluşalım!",
            "de": "Nein, danke. Aber lass uns trotzdem nächste Woche treffen!"
          }
        ]
      },
      "uebungen": [
        {
          "art": "zuordnen",
          "vokabeln": [
            "w15-cunku",
            "w15-bu-yuzden",
            "w15-yine-de",
            "w15-ayrica"
          ]
