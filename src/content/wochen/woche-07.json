      "tag": 1,
      "titel": "Wie ist das Wetter?",
      "kannZiel": "das Wetter beschreiben",
      "vokabeln": [
        { "id": "w07-hava-nasil", "tr": "Hava nasıl?", "de": "Wie ist das Wetter?", "typ": "chunk", "beispiel": { "tr": "Bugün hava nasıl?", "de": "Wie ist das Wetter heute?" } },
        { "id": "w07-soguk", "tr": "soğuk", "de": "kalt", "typ": "wort", "beispiel": { "tr": "Hava çok soğuk.", "de": "Es ist sehr kalt." } },
        { "id": "w07-serin", "tr": "serin", "de": "kühl", "typ": "wort", "beispiel": { "tr": "Akşam hava serin.", "de": "Abends ist es kühl." } },
        { "id": "w07-gunesli", "tr": "güneşli", "de": "sonnig", "typ": "wort", "beispiel": { "tr": "Bugün güneşli!", "de": "Heute ist es sonnig!" } },
        { "id": "w07-bulutlu", "tr": "bulutlu", "de": "bewölkt", "typ": "wort", "beispiel": { "tr": "Hava biraz bulutlu.", "de": "Es ist etwas bewölkt." } },
        { "id": "w07-yagmur", "tr": "yağmur", "de": "Regen", "typ": "wort", "beispiel": { "tr": "Yağmur yağıyor.", "de": "Es regnet." } },
        { "id": "w07-kar", "tr": "kar", "de": "Schnee", "typ": "wort", "beispiel": { "tr": "Kar yağıyor! Inaya, bak!", "de": "Es schneit! Inaya, schau!" } },
        { "id": "w07-ruzgar", "tr": "rüzgâr", "de": "Wind", "typ": "wort", "beispiel": { "tr": "Bugün çok rüzgâr var.", "de": "Heute ist es sehr windig." } },
        { "id": "w07-semsiye", "tr": "şemsiye", "de": "Regenschirm", "typ": "wort", "beispiel": { "tr": "Şemsiyeni unutma!", "de": "Vergiss deinen Regenschirm nicht!" } }
      ],
      "grammatik": {
        "titel": "Hava + Adjektiv",
        "erklaerung": [
          "Wetter beschreibst du mit hava (Wetter/Luft) + Adjektiv: Hava soğuk. = Es ist kalt.",
          "Regen und Schnee „fallen“: Yağmur yağıyor. (Es regnet.) Kar yağıyor. (Es schneit.)",
          "-lı/-li/-lu/-lü macht aus Nomen Wetter-Adjektive: güneş → güneşli, bulut → bulutlu."
        ],
        "beispiele": [
          { "tr": "Hava çok soğuk.", "de": "Es ist sehr kalt." },
          { "tr": "Yağmur yağıyor.", "de": "Es regnet." },
          { "tr": "Bugün güneşli.", "de": "Heute ist es sonnig." }
        ]
      },
      "dialog": {
        "titel": "Blick aus dem Fenster",
        "zeilen": [
          { "sprecher": "Pasha", "tr": "Günaydın! Hava nasıl?", "de": "Guten Morgen! Wie ist das Wetter?" },
          { "sprecher": "Sherin", "tr": "Çok soğuk. Ve yağmur yağıyor.", "de": "Sehr kalt. Und es regnet." },
          { "sprecher": "Pasha", "tr": "Yine mi? Almanya'da hep yağmur!", "de": "Schon wieder? In Deutschland regnet es immer!" },
          { "sprecher": "Sherin", "tr": "Ama öğleden sonra güneşli.", "de": "Aber am Nachmittag wird es sonnig." },
          { "sprecher": "Pasha", "tr": "Tamam, o zaman öğleden sonra parka gidiyoruz.", "de": "Gut, dann gehen wir am Nachmittag in den Park." },
          { "sprecher": "Sherin", "tr": "Şemsiyeyi unutma!", "de": "Vergiss den Regenschirm nicht!" }
        ]
      },
      "uebungen": [
        { "art": "zuordnen", "vokabeln": ["w07-soguk", "w07-serin", "w07-gunesli", "w07-bulutlu"] },
        { "art": "auswahl_de_tr", "vokabel": "w07-hava-nasil" },
        { "art": "hoeren", "vokabel": "w07-yagmur" },
        { "art": "satzbau", "tr": "Kar yağıyor! Inaya, bak!", "de": "Es schneit! Inaya, schau!" },
        { "art": "luecke", "satz": "Bugün güneş___.", "loesung": "li", "optionen": ["li", "lı", "lu"], "de": "Heute ist es sonnig." },
        { "art": "auswahl_tr_de", "vokabel": "w07-ruzgar" },
        { "art": "hoeren", "vokabel": "w07-semsiye" },
        { "art": "tippen", "vokabel": "w07-kar" },
        { "art": "satzbau", "tr": "Hava çok soğuk.", "de": "Es ist sehr kalt." }
      ],
      "sprechauftrag": {
        "aufgabe": "Macht ab heute jeden Morgen einen Wetterbericht auf Türkisch am Fenster: Pasha fragt „Hava nasıl?“, du antwortest mit zwei Sätzen.",
        "mustersaetze": [
          { "tr": "Hava soğuk ve bulutlu.", "de": "Es ist kalt und bewölkt." },
          { "tr": "Yağmur yağıyor.", "de": "Es regnet." },
          { "tr": "Şemsiyeyi unutma!", "de": "Vergiss den Regenschirm nicht!" }
        ]
      },
      "alltagssatz": { "tr": "Hava çok soğuk!", "de": "Es ist so kalt!", "wann": "Beim nächsten Gassi mit Amani – im November garantiert." },
      "merktipp": { "titel": "Regen fällt", "text": "Im Türkischen „fällt“ das Wetter: yağmur yağıyor (Regen fällt), kar yağıyor (Schnee fällt). yağmur und yağmak gehören zusammen – das Wort sagt es schon." }
    },
