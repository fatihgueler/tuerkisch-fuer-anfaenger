            ["kahvaltı yapmak", "kahvaltı yapıyorum"],
            ["duş almak", "duş alıyorum"]
          ]
        },
        "beispiele": [
          { "tr": "Önce kahvaltı yapıyoruz, sonra giyiniyoruz.", "de": "Zuerst frühstücken wir, dann ziehen wir uns an." },
