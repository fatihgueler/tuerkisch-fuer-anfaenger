      "grammatik": {
        "titel": "Präsens: -(ı)yor",
        "erklaerung": [
          "Verben enden in der Grundform auf -mak/-mek. Weg damit – übrig bleibt der Stamm: iç-mek → iç.",
          "Dann kommt -ıyor/-iyor/-uyor/-üyor (4-fach) und die Person: iç + iyor + um = içiyorum (ich trinke).",
          "-yor selbst ändert sich nie – nur der Vokal davor passt sich an.",
          "Endet der Stamm auf Vokal, kommt direkt -yor: uyu → uyuyor."
        ],
        "tabelle": {
          "kopf": ["", "içmek", "uyumak", "gelmek"],
          "zeilen": [
            ["ich", "içiyorum", "uyuyorum", "geliyorum"],
            ["du", "içiyorsun", "uyuyorsun", "geliyorsun"],
            ["er/sie", "içiyor", "uyuyor", "geliyor"],
            ["wir", "içiyoruz", "uyuyoruz", "geliyoruz"]
          ]
        },
        "beispiele": [
          { "tr": "Çay içiyorum.", "de": "Ich trinke Tee." },
          { "tr": "Inaya uyuyor.", "de": "Inaya schläft." },
          { "tr": "Ne yapıyorsun?", "de": "Was machst du?" }
        ]
      },
      "dialog": {
