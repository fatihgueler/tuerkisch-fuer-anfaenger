          { "sprecher": "Pasha", "tr": "Inaya ne yapıyor?", "de": "Was macht Inaya?" },
          { "sprecher": "Sherin", "tr": "Inaya uyuyor. Amani de uyuyor.", "de": "Inaya schläft. Amani auch." },
          { "sprecher": "Pasha", "tr": "Süper! Ben de eve geliyorum.", "de": "Super! Ich komme jetzt auch nach Hause." },
          { "sprecher": "Sherin", "tr": "Tamam, görüşürüz!", "de": "Okay, bis gleich!" }
        ]
      },
      "uebungen": [
        { "art": "zuordnen", "vokabeln": ["w04-uyumak", "w04-icmek", "w04-oynamak", "w04-gelmek"] },
        { "art": "luecke", "satz": "Çay iç___.", "loesung": "iyorum", "optionen": ["iyorum", "ıyorum", "uyorum"], "de": "Ich trinke Tee.", "hinweis": "iç – Vokal i" },
