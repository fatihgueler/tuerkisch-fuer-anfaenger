          { "sprecher": "Pasha", "tr": "Tamam. Önce duş alıyorum, sonra kahvaltı hazırlıyorum.", "de": "Okay. Erst dusche ich, dann mache ich Frühstück." },
          { "sprecher": "Sherin", "tr": "Hızlı ol! Inaya aç!", "de": "Mach schnell! Inaya hat Hunger!" }
