{
  "woche": 1,
  "lektionen": [
    {
      "woche": 1,
      "tag": 1,
      "titel": "Ich, du, er, sie",
      "kannZiel": "dich mit Namen vorstellen und nach dem Namen fragen",
      "vokabeln": [
        { "id": "w01-ben", "tr": "ben", "de": "ich", "typ": "wort", "beispiel": { "tr": "Ben Sherin.", "de": "Ich bin Sherin." } },
        { "id": "w01-sen", "tr": "sen", "de": "du", "typ": "wort", "beispiel": { "tr": "Sen nasılsın?", "de": "Wie geht's dir?" } },
        {
          "id": "w01-o",
          "tr": "o",
          "de": "er / sie / es",
          "typ": "wort",
          "beispiel": { "tr": "O kim?", "de": "Wer ist das?" },
          "merktipp": "Kein Streit um er oder sie: o heißt beides – und auch „es“. Praktisch!"
        },
        { "id": "w01-benim-adim", "tr": "Benim adım …", "de": "Ich heiße … / Mein Name ist …", "typ": "chunk", "beispiel": { "tr": "Benim adım Sherin.", "de": "Ich heiße Sherin." } },
        { "id": "w01-senin-adin-ne", "tr": "Senin adın ne?", "de": "Wie heißt du?", "typ": "chunk", "beispiel": { "tr": "Merhaba! Senin adın ne?", "de": "Hallo! Wie heißt du?" } },
        { "id": "w01-memnun-oldum", "tr": "Memnun oldum.", "de": "Freut mich.", "typ": "chunk", "beispiel": { "tr": "Ben Sherin. Memnun oldum.", "de": "Ich bin Sherin. Freut mich." } },
        { "id": "w01-ben-de", "tr": "ben de", "de": "ich auch", "typ": "chunk", "beispiel": { "tr": "Ben de memnun oldum.", "de": "Freut mich auch." } },
        { "id": "w01-kim", "tr": "kim?", "de": "wer?", "typ": "wort", "beispiel": { "tr": "Bu kim?", "de": "Wer ist das?" } },
        { "id": "w01-bu", "tr": "bu", "de": "das (hier) / dies", "typ": "wort", "beispiel": { "tr": "Bu Inaya.", "de": "Das ist Inaya." } }
      ],
      "grammatik": {
        "titel": "Personalpronomen – wer?",
        "erklaerung": [
          "Türkisch hat sechs Personalpronomen (Fürwörter für Personen).",
          "o heißt „er“, „sie“ und „es“ – es gibt kein grammatisches Geschlecht.",
          "siz ist „ihr“ und gleichzeitig das höfliche „Sie“. Das brauchst du erst später.",
          "Pronomen lässt man oft weg, weil die Endung schon zeigt, wer gemeint ist – das kommt morgen."
        ],
        "tabelle": {
          "kopf": ["Türkisch", "Deutsch"],
          "zeilen": [
            ["ben", "ich"],
            ["sen", "du"],
            ["o", "er / sie / es"],
            ["biz", "wir"],
            ["siz", "ihr / Sie"],
            ["onlar", "sie (Mehrzahl)"]
          ]
        },
        "beispiele": [
          { "tr": "Ben Sherin.", "de": "Ich bin Sherin." },
          { "tr": "Bu Pasha.", "de": "Das ist Pasha." },
          { "tr": "O kim?", "de": "Wer ist das?" }
        ]
      },
      "dialog": {
        "titel": "Wie damals: das erste Kennenlernen",
        "zeilen": [
          { "sprecher": "Pasha", "tr": "Merhaba! Benim adım Pasha. Senin adın ne?", "de": "Hallo! Ich heiße Pasha. Wie heißt du?" },
          { "sprecher": "Sherin", "tr": "Merhaba! Benim adım Sherin.", "de": "Hallo! Ich heiße Sherin." },
          { "sprecher": "Pasha", "tr": "Memnun oldum.", "de": "Freut mich." },
          { "sprecher": "Sherin", "tr": "Ben de memnun oldum.", "de": "Freut mich auch." },
          { "sprecher": "Pasha", "tr": "Bu kim?", "de": "Und wer ist das?" },
          { "sprecher": "Sherin", "tr": "Bu Inaya. Bu da Amani.", "de": "Das ist Inaya. Und das ist Amani." }
        ]
      },
      "uebungen": [
        { "art": "auswahl_de_tr", "vokabel": "w01-ben" },
        { "art": "auswahl_tr_de", "vokabel": "w01-o" },
        { "art": "hoeren", "vokabel": "w01-senin-adin-ne" },
        { "art": "zuordnen", "vokabeln": ["w01-ben", "w01-sen", "w01-o", "w01-kim"] },
        { "art": "satzbau", "tr": "Benim adım Sherin.", "de": "Ich heiße Sherin." },
        { "art": "tippen", "vokabel": "w01-bu" },
        { "art": "hoeren", "vokabel": "w01-memnun-oldum" },
        {
          "art": "luecke",
          "satz": "Ben ___ memnun oldum.",
          "loesung": "de",
          "optionen": ["de", "bu", "kim"],
          "de": "Freut mich auch."
        },
        { "art": "auswahl_de_tr", "vokabel": "w01-senin-adin-ne" },
        { "art": "satzbau", "tr": "Bu kim?", "de": "Wer ist das?", "extra": ["ben"] },
        { "art": "tippen", "vokabel": "w01-kim" }
      ],
      "sprechauftrag": {
        "aufgabe": "Spielt euer erstes Kennenlernen nach – auf Türkisch! Pasha fragt nach deinem Namen, du stellst dich vor. Dann zeigt er auf Inaya und Amani und fragt „Bu kim?“.",
        "mustersaetze": [
          { "tr": "Benim adım Sherin. Senin adın ne?", "de": "Ich heiße Sherin. Wie heißt du?" },
          { "tr": "Ben de memnun oldum.", "de": "Freut mich auch." },
          { "tr": "Bu Inaya. Bu da Amani.", "de": "Das ist Inaya. Und das ist Amani." }
        ]
      },
      "alltagssatz": { "tr": "Bu kim?", "de": "Wer ist das?", "wann": "Zeig Pasha ein Foto aus seiner Familie und frag ihn." },
      "merktipp": {
        "titel": "Pronomen sind optional",
        "text": "Im Türkischen darf man ben, sen, o meistens weglassen – die Endung verrät, wer gemeint ist. Mit Pronomen klingt es betont: „BEN Sherin“ = „ICH bin Sherin“."
      }
    },
    {
      "woche": 1,
      "tag": 2,
      "titel": "Ich bin müde – „sein“ als Lego-Stein",
      "kannZiel": "sagen, wie es dir geht und wer du bist",
      "vokabeln": [
        {
          "id": "w01-cok",
          "tr": "çok",
          "de": "sehr / viel",
          "typ": "wort",
          "beispiel": { "tr": "Çok yorgunum.", "de": "Ich bin total müde." },
          "merktipp": "çok klingt wie „Schock“ – so viel!"
        },
        { "id": "w01-yorgun", "tr": "yorgun", "de": "müde", "typ": "wort", "beispiel": { "tr": "Pasha yorgun.", "de": "Pasha ist müde." } },
        { "id": "w01-mutlu", "tr": "mutlu", "de": "glücklich", "typ": "wort", "beispiel": { "tr": "Çok mutluyum.", "de": "Ich bin sehr glücklich." } },
        { "id": "w01-ac", "tr": "aç", "de": "hungrig", "typ": "wort", "beispiel": { "tr": "Inaya aç.", "de": "Inaya hat Hunger." } },
        {
          "id": "w01-evli",
          "tr": "evli",
          "de": "verheiratet",
          "typ": "wort",
          "beispiel": { "tr": "Ben evliyim.", "de": "Ich bin verheiratet." },
          "merktipp": "evli kommt von ev (Haus): Wer verheiratet ist, hat ein gemeinsames Haus."
        },
        { "id": "w01-alman", "tr": "Alman", "de": "Deutsche / Deutscher", "typ": "wort", "beispiel": { "tr": "Ben Almanım.", "de": "Ich bin Deutsche." } },
        { "id": "w01-turk", "tr": "Türk", "de": "Türke / Türkin", "typ": "wort", "beispiel": { "tr": "Pasha Türk.", "de": "Pasha ist Türke." } },
        {
          "id": "w01-kuafor",
          "tr": "kuaför",
          "de": "Friseurin / Friseur",
          "typ": "wort",
          "beispiel": { "tr": "Ben kuaförüm.", "de": "Ich bin Friseurin." },
          "merktipp": "Klingt wie „Coiffeur“ – das Wort kommt aus dem Französischen."
        }
      ],
      "grammatik": {
        "titel": "„sein“ ist eine Endung",
        "erklaerung": [
          "„sein“ ist im Türkischen kein eigenes Wort, sondern ein Lego-Stein, den du ans Wort klickst: yorgun + um = yorgunum (ich bin müde).",
          "Den Vokal der Endung bestimmt der letzte Vokal im Wort (Vokalharmonie): a/ı → ı, e/i → i, o/u → u, ö/ü → ü.",
          "Endet das Wort auf einen Vokal, kommt ein y dazwischen: evli → evliyim.",
          "Bei „er/sie“ (o) braucht man im Gespräch meistens gar keine Endung: Pasha yorgun.",
          "Die Endung ist unbetont – betont wird die Silbe davor: yorGUNum."
        ],
        "tabelle": {
          "kopf": ["", "a / ı", "e / i", "o / u", "ö / ü"],
          "zeilen": [
            ["ich bin", "Almanım", "evliyim", "yorgunum", "kuaförüm"],
            ["du bist", "Almansın", "evlisin", "yorgunsun", "kuaförsün"],
            ["er/sie ist", "Alman", "evli", "yorgun", "kuaför"]
          ]
        },
        "beispiele": [
          { "tr": "Çok yorgunum.", "de": "Ich bin total müde." },
          { "tr": "Ben Almanım, Pasha Türk.", "de": "Ich bin Deutsche, Pasha ist Türke." },
          { "tr": "Ben kuaförüm.", "de": "Ich bin Friseurin." }
        ]
      },
      "dialog": {
        "titel": "Abends auf dem Sofa",
        "zeilen": [
          { "sprecher": "Pasha", "tr": "İyi akşamlar, Sherin. Nasılsın?", "de": "Guten Abend, Sherin. Wie geht's dir?" },
          { "sprecher": "Sherin", "tr": "Çok yorgunum. Sen?", "de": "Ich bin total müde. Und du?" },
          { "sprecher": "Pasha", "tr": "Ben de yorgunum. Ama mutluyum.", "de": "Ich bin auch müde. Aber glücklich." },
          { "sprecher": "Sherin", "tr": "Inaya da mutlu. Bak!", "de": "Inaya ist auch glücklich. Schau!" },
          { "sprecher": "Pasha", "tr": "Ama Amani aç.", "de": "Aber Amani hat Hunger." },
          { "sprecher": "Sherin", "tr": "Amani her zaman aç!", "de": "Amani hat immer Hunger!" }
        ]
      },
      "uebungen": [
        { "art": "auswahl_tr_de", "vokabel": "w01-yorgun" },
        {
          "art": "luecke",
          "satz": "Çok yorgun___.",
          "loesung": "um",
          "optionen": ["um", "ım", "im", "üm"],
          "de": "Ich bin total müde.",
          "hinweis": "Letzter Vokal im Wort: u"
        },
        { "art": "auswahl_de_tr", "vokabel": "w01-mutlu" },
        {
          "art": "luecke",
          "satz": "Ben kuaför___.",
          "loesung": "üm",
          "optionen": ["üm", "um", "im", "ım"],
          "de": "Ich bin Friseurin.",
          "hinweis": "Letzter Vokal im Wort: ö"
        },
        { "art": "hoeren", "vokabel": "w01-ac" },
        { "art": "zuordnen", "vokabeln": ["w01-cok", "w01-yorgun", "w01-mutlu", "w01-evli"] },
        {
          "art": "luecke",
          "satz": "Sen Alman___.",
          "loesung": "sın",
          "optionen": ["sın", "sin", "sun", "sün"],
          "de": "Du bist Deutsche.",
          "hinweis": "Letzter Vokal im Wort: a"
        },
        { "art": "satzbau", "tr": "Ben Almanım, Pasha Türk.", "de": "Ich bin Deutsche, Pasha ist Türke." },
        { "art": "tippen", "vokabel": "w01-cok" },
        {
          "art": "luecke",
          "satz": "Ben evli___.",
          "loesung": "yim",
          "optionen": ["yim", "im", "yım"],
          "de": "Ich bin verheiratet.",
          "hinweis": "evli endet auf einen Vokal → y dazwischen"
        },
        { "art": "hoeren", "vokabel": "w01-kuafor" }
      ],
      "sprechauftrag": {
        "aufgabe": "Sag Pasha heute Abend drei Sätze darüber, wie du dich fühlst und wer du bist. Benutze: yorgun, mutlu, aç, çok. Pasha antwortet mit „Ben de …“ oder sagt, wie es ihm geht.",
        "mustersaetze": [
          { "tr": "Çok yorgunum.", "de": "Ich bin total müde." },
          { "tr": "Ama mutluyum.", "de": "Aber ich bin glücklich." },
          { "tr": "Ben kuaförüm!", "de": "Ich bin Friseurin!" }
        ]
      },
      "alltagssatz": { "tr": "Açım!", "de": "Ich habe Hunger!", "wann": "Kurz vor dem Abendessen – sag es laut in Richtung Küche." },
      "merktipp": {
        "titel": "Endungen sind Lego-Steine",
        "text": "Du baust Wörter wie mit Lego: yorgun + um, Alman + ım, kuaför + üm. Der Stein passt sich farblich an – das ist die Vokalharmonie."
      }
    },
    {
      "woche": 1,
      "tag": 3,
      "titel": "Woher? Wo? – Garbsen'de oturuyorum",
      "kannZiel": "sagen, woher du kommst, wo du wohnst und welche Sprachen du sprichst",
      "vokabeln": [
        { "id": "w01-nerelisin", "tr": "Nerelisin?", "de": "Woher kommst du?", "typ": "chunk", "beispiel": { "tr": "Merhaba! Nerelisin?", "de": "Hallo! Woher kommst du?" } },
        { "id": "w01-almanyaliyim", "tr": "Almanyalıyım.", "de": "Ich komme aus Deutschland.", "typ": "chunk", "beispiel": { "tr": "Ben Almanyalıyım, Pasha Türk.", "de": "Ich komme aus Deutschland, Pasha ist Türke." } },
        { "id": "w01-nerede-oturuyorsun", "tr": "Nerede oturuyorsun?", "de": "Wo wohnst du?", "typ": "chunk", "beispiel": { "tr": "Sherin, nerede oturuyorsun?", "de": "Sherin, wo wohnst du?" } },
        { "id": "w01-garbsende-oturuyorum", "tr": "Garbsen'de oturuyorum.", "de": "Ich wohne in Garbsen.", "typ": "chunk", "beispiel": { "tr": "Garbsen'de oturuyorum, Hannover'in yanında.", "de": "Ich wohne in Garbsen, bei Hannover." } },
        { "id": "w01-nerede", "tr": "nerede?", "de": "wo?", "typ": "wort", "beispiel": { "tr": "Amani nerede?", "de": "Wo ist Amani?" } },
        { "id": "w01-almanca", "tr": "Almanca", "de": "Deutsch (Sprache)", "typ": "wort", "beispiel": { "tr": "Ben Almanca konuşuyorum.", "de": "Ich spreche Deutsch." } },
        { "id": "w01-turkce", "tr": "Türkçe", "de": "Türkisch (Sprache)", "typ": "wort", "beispiel": { "tr": "Türkçe öğreniyorum.", "de": "Ich lerne Türkisch." } },
        { "id": "w01-biraz", "tr": "biraz", "de": "ein bisschen", "typ": "wort", "beispiel": { "tr": "Biraz Türkçe konuşuyorum.", "de": "Ich spreche ein bisschen Türkisch." } }
      ],
      "grammatik": {
        "titel": "Chunks zuerst: wohnen, kommen, sprechen",
        "erklaerung": [
          "Lern „Garbsen'de oturuyorum“ erst einmal als festen Block – die Bauteile kommen in Woche 3 und 4.",
          "-de heißt hier „in“: Garbsen'de = in Garbsen. Bei Namen trennt ein Apostroph die Endung ab.",
          "-ca/-çe macht aus einem Volk die Sprache: Alman → Almanca (Deutsch), Türk → Türkçe (Türkisch).",
          "-lı/-li heißt „von dort“: Almanya (Deutschland) → Almanyalı (aus Deutschland)."
        ],
        "beispiele": [
          { "tr": "Garbsen'de oturuyorum.", "de": "Ich wohne in Garbsen." },
          { "tr": "Biraz Türkçe konuşuyorum.", "de": "Ich spreche ein bisschen Türkisch." },
          { "tr": "Almanyalıyım.", "de": "Ich komme aus Deutschland." }
        ]
      },
      "dialog": {
        "titel": "Neue Nachbarin im Treppenhaus",
        "zeilen": [
          { "sprecher": "Elif", "tr": "Merhaba! Ben Elif. Senin adın ne?", "de": "Hallo! Ich bin Elif. Wie heißt du?" },
          { "sprecher": "Sherin", "tr": "Merhaba! Benim adım Sherin. Memnun oldum.", "de": "Hallo! Ich heiße Sherin. Freut mich." },
          { "sprecher": "Elif", "tr": "Ben de memnun oldum. Nerelisin?", "de": "Freut mich auch. Woher kommst du?" },
          { "sprecher": "Sherin", "tr": "Almanyalıyım. Burada, Garbsen'de oturuyorum.", "de": "Aus Deutschland. Ich wohne hier in Garbsen." },
          { "sprecher": "Elif", "tr": "Türkçe konuşuyor musun?", "de": "Sprichst du Türkisch?" },
          { "sprecher": "Sherin", "tr": "Biraz. Türkçe öğreniyorum.", "de": "Ein bisschen. Ich lerne Türkisch." },
          { "sprecher": "Elif", "tr": "Çok iyi!", "de": "Sehr gut!" }
        ]
      },
      "uebungen": [
        { "art": "auswahl_tr_de", "vokabel": "w01-nerelisin" },
        { "art": "hoeren", "vokabel": "w01-garbsende-oturuyorum" },
        { "art": "auswahl_de_tr", "vokabel": "w01-almanca" },
        { "art": "satzbau", "tr": "Biraz Türkçe konuşuyorum.", "de": "Ich spreche ein bisschen Türkisch." },
        { "art": "tippen", "vokabel": "w01-nerede" },
        {
          "art": "luecke",
          "satz": "Garbsen'___ oturuyorum.",
          "loesung": "de",
          "optionen": ["de", "da", "di"],
          "de": "Ich wohne in Garbsen.",
          "hinweis": "Garbsen – letzter Vokal e"
        },
        { "art": "zuordnen", "vokabeln": ["w01-almanca", "w01-turkce", "w01-biraz", "w01-nerede"] },
        { "art": "auswahl_de_tr", "vokabel": "w01-nerede-oturuyorsun" },
        { "art": "hoeren", "vokabel": "w01-almanyaliyim" },
        { "art": "satzbau", "tr": "Türkçe öğreniyorum.", "de": "Ich lerne Türkisch." },
        { "art": "tippen", "vokabel": "w01-biraz" }
      ],
      "sprechauftrag": {
        "aufgabe": "Stell dich Pasha vor, als würdet ihr euch nicht kennen: Name, woher du kommst, wo du wohnst und welche Sprachen du sprichst. Pasha fragt nach – du antwortest.",
        "mustersaetze": [
          { "tr": "Benim adım Sherin. Almanyalıyım.", "de": "Ich heiße Sherin. Ich komme aus Deutschland." },
          { "tr": "Garbsen'de oturuyorum.", "de": "Ich wohne in Garbsen." },
          { "tr": "Almanca konuşuyorum. Biraz Türkçe konuşuyorum.", "de": "Ich spreche Deutsch. Ein bisschen Türkisch spreche ich auch." }
        ]
      },
      "alltagssatz": {
        "tr": "Biraz Türkçe konuşuyorum.",
        "de": "Ich spreche ein bisschen Türkisch.",
        "wann": "Wenn heute jemand Türkisch mit dir spricht – auch am Telefon mit Pashas Familie."
      },
      "merktipp": {
        "titel": "Ein Stein für alle Sprachen",
        "text": "-ca/-çe macht aus einem Volk die Sprache: Alman-ca, Türk-çe, İngiliz-ce (Englisch). Ein Lego-Stein für alle Sprachen."
      }
    },
    {
      "woche": 1,
      "tag": 4,
      "titel": "Fragen mit mi",
      "kannZiel": "Ja/Nein-Fragen stellen und mit „nicht“ antworten",
      "vokabeln": [
        { "id": "w01-mi", "tr": "mi? (mı, mu, mü)", "de": "Fragewort für Ja/Nein-Fragen", "typ": "wort", "beispiel": { "tr": "Yorgun musun?", "de": "Bist du müde?" } },
        { "id": "w01-degil", "tr": "değil", "de": "nicht (bei „sein“)", "typ": "wort", "beispiel": { "tr": "Yorgun değilim.", "de": "Ich bin nicht müde." } },
        { "id": "w01-ac-misin", "tr": "Aç mısın?", "de": "Hast du Hunger?", "typ": "chunk", "beispiel": { "tr": "Pasha, aç mısın?", "de": "Pasha, hast du Hunger?" } },
        { "id": "w01-hazir", "tr": "hazır", "de": "fertig / bereit", "typ": "wort", "beispiel": { "tr": "Hazır mısın?", "de": "Bist du fertig?" } },
        { "id": "w01-uykulu", "tr": "uykulu", "de": "schläfrig", "typ": "wort", "beispiel": { "tr": "Inaya çok uykulu.", "de": "Inaya ist sehr schläfrig." } },
        { "id": "w01-sicak", "tr": "sıcak", "de": "heiß / warm", "typ": "wort", "beispiel": { "tr": "Çay sıcak mı?", "de": "Ist der Tee heiß?" } },
        { "id": "w01-tamam", "tr": "tamam", "de": "okay / in Ordnung", "typ": "wort", "beispiel": { "tr": "Tamam, teşekkürler.", "de": "Okay, danke." } },
        { "id": "w01-tabii", "tr": "tabii", "de": "klar / natürlich", "typ": "wort", "beispiel": { "tr": "Mutlu musun? – Tabii!", "de": "Bist du glücklich? – Na klar!" } },
        { "id": "w01-gercekten-mi", "tr": "Gerçekten mi?", "de": "Wirklich?", "typ": "chunk", "beispiel": { "tr": "Gerçekten mi? Çok iyi!", "de": "Wirklich? Super!" } }
      ],
      "grammatik": {
        "titel": "mi – das gesprochene Fragezeichen",
        "erklaerung": [
          "Ja/Nein-Fragen bildest du mit dem kleinen Wort mi. Es steht hinter dem Wort, nach dem du fragst.",
          "mi folgt der Vokalharmonie: mı, mi, mu, mü.",
          "Die Personalendung hängt dann an mi: Yorgun musun? = Bist du müde?",
          "Verneinung bei „sein“: değil + Endung. Yorgun değilim. = Ich bin nicht müde."
        ],
        "tabelle": {
          "kopf": ["letzter Vokal", "Frage", "Beispiel"],
          "zeilen": [
            ["a / ı", "mı", "Aç mısın?"],
            ["e / i", "mi", "Evli misin?"],
            ["o / u", "mu", "Yorgun musun?"],
            ["ö / ü", "mü", "Kuaför müsün?"]
          ]
        },
        "beispiele": [
          { "tr": "Aç mısın?", "de": "Hast du Hunger?" },
          { "tr": "Hazır mısın?", "de": "Bist du fertig?" },
          { "tr": "Hayır, yorgun değilim.", "de": "Nein, ich bin nicht müde." }
        ]
      },
      "dialog": {
