{
  "woche": 2,
  "lektionen": [
    {
      "woche": 2,
      "tag": 1,
      "titel": "Familie & Mehrzahl",
      "kannZiel": "Familienmitglieder benennen und die Mehrzahl bilden",
      "vokabeln": [
        { "id": "w02-aile", "tr": "aile", "de": "Familie", "typ": "wort", "beispiel": { "tr": "Biz küçük bir aileyiz.", "de": "Wir sind eine kleine Familie." } },
        { "id": "w02-anne", "tr": "anne", "de": "Mutter / Mama", "typ": "wort", "beispiel": { "tr": "Anne, neredesin?", "de": "Mama, wo bist du?" } },
        { "id": "w02-baba", "tr": "baba", "de": "Vater / Papa", "typ": "wort", "beispiel": { "tr": "Inaya, baba nerede?", "de": "Inaya, wo ist Papa?" } },
        { "id": "w02-kiz", "tr": "kız", "de": "Mädchen / Tochter", "typ": "wort", "beispiel": { "tr": "Inaya küçük bir kız.", "de": "Inaya ist ein kleines Mädchen." } },
        { "id": "w02-ogul", "tr": "oğul", "de": "Sohn", "typ": "wort", "beispiel": { "tr": "Oğlu mu var, kızı mı?", "de": "Hat sie einen Sohn oder eine Tochter?" }, "merktipp": "oğul verliert mit Endung sein u: oğul → oğlu (sein Sohn), oğlum (mein Sohn)." },
        { "id": "w02-kardes", "tr": "kardeş", "de": "Geschwister (Bruder / Schwester)", "typ": "wort", "beispiel": { "tr": "Onlar kardeş.", "de": "Die beiden sind Geschwister." } },
        { "id": "w02-bebek", "tr": "bebek", "de": "Baby", "typ": "wort", "beispiel": { "tr": "Bebek uyuyor.", "de": "Das Baby schläft." } },
        { "id": "w02-cocuk", "tr": "çocuk", "de": "Kind", "typ": "wort", "beispiel": { "tr": "Çocuklar çok mutlu.", "de": "Die Kinder sind sehr glücklich." } },
        { "id": "w02-kopek", "tr": "köpek", "de": "Hund", "typ": "wort", "beispiel": { "tr": "Amani büyük bir köpek.", "de": "Amani ist ein großer Hund." } }
      ],
      "grammatik": {
        "titel": "Mehrzahl: -lar / -ler",
        "erklaerung": [
          "Die Mehrzahl ist ein Lego-Stein: -lar oder -ler.",
          "Nach a, ı, o, u kommt -lar, nach e, i, ö, ü kommt -ler (Vokalharmonie, 2-fach).",
          "Nach Zahlen bleibt es bei der Einzahl: iki çocuk (zwei Kinder) – nicht „iki çocuklar“."
        ],
        "tabelle": {
          "kopf": ["Einzahl", "Mehrzahl"],
          "zeilen": [
            ["anne", "anneler"],
            ["kız", "kızlar"],
            ["çocuk", "çocuklar"],
            ["köpek", "köpekler"],
            ["bebek", "bebekler"],
            ["kardeş", "kardeşler"]
          ]
        },
        "beispiele": [
          { "tr": "Çocuklar çok mutlu.", "de": "Die Kinder sind sehr glücklich." },
          { "tr": "Köpekler orada.", "de": "Die Hunde sind dort." },
          { "tr": "İki çocuk, bir köpek.", "de": "Zwei Kinder, ein Hund." }
        ]
      },
      "dialog": {
        "titel": "Auf dem Spielplatz",
        "zeilen": [
          { "sprecher": "Elif", "tr": "Merhaba Sherin!", "de": "Hallo Sherin!" },
          { "sprecher": "Sherin", "tr": "Merhaba Elif! Bak, bu Inaya.", "de": "Hallo Elif! Schau, das ist Inaya." },
          { "sprecher": "Elif", "tr": "Ay, çok tatlı bir bebek!", "de": "Oh, was für ein süßes Baby!" },
          { "sprecher": "Sherin", "tr": "Teşekkürler! Çocukların nerede?", "de": "Danke! Wo sind deine Kinder?" },
          { "sprecher": "Elif", "tr": "Orada. Bak, köpekler de orada!", "de": "Da drüben. Schau, die Hunde sind auch da!" },
          { "sprecher": "Sherin", "tr": "Amani, gel! Köpekler çok büyük!", "de": "Amani, komm! Die Hunde sind sehr groß!" }
        ]
      },
      "uebungen": [
        { "art": "auswahl_de_tr", "vokabel": "w02-aile" },
        { "art": "zuordnen", "vokabeln": ["w02-anne", "w02-baba", "w02-kiz", "w02-ogul"] },
        { "art": "luecke", "satz": "Çocuk___ çok mutlu.", "loesung": "lar", "optionen": ["lar", "ler"], "de": "Die Kinder sind sehr glücklich.", "hinweis": "çocuk – letzter Vokal u" },
        { "art": "hoeren", "vokabel": "w02-bebek" },
        { "art": "luecke", "satz": "Köpek___ orada.", "loesung": "ler", "optionen": ["lar", "ler"], "de": "Die Hunde sind dort.", "hinweis": "köpek – letzter Vokal e" },
        { "art": "auswahl_tr_de", "vokabel": "w02-kardes" },
        { "art": "tippen", "vokabel": "w02-anne" },
        { "art": "satzbau", "tr": "Amani büyük bir köpek.", "de": "Amani ist ein großer Hund." },
        { "art": "luecke", "satz": "İki ___ var.", "loesung": "çocuk", "optionen": ["çocuk", "çocuklar"], "de": "Es gibt zwei Kinder.", "hinweis": "Nach Zahlen: Einzahl!" },
        { "art": "hoeren", "vokabel": "w02-cocuk" },
        { "art": "tippen", "vokabel": "w02-kiz" }
      ],
      "sprechauftrag": {
        "aufgabe": "Zeig Inaya Bilder (Buch oder Handy) und benenne alles auf Türkisch: anne, baba, bebek, köpek, çocuklar. Pasha prüft, ob die Mehrzahl stimmt.",
        "mustersaetze": [
          { "tr": "Bak Inaya, bu bir köpek!", "de": "Schau Inaya, das ist ein Hund!" },
          { "tr": "Bunlar çocuklar.", "de": "Das sind Kinder." },
          { "tr": "Bu anne, bu da baba.", "de": "Das ist die Mama und das der Papa." }
        ]
      },
      "alltagssatz": { "tr": "Inaya, baba nerede?", "de": "Inaya, wo ist Papa?", "wann": "Wenn Pasha nach Hause kommt – Inaya zeigt bestimmt auf ihn." },
      "merktipp": { "titel": "Zahl = keine Mehrzahl", "text": "Im Türkischen zeigt die Zahl schon, dass es mehrere sind – also kein -lar: üç köpek, beş çocuk. Doppelt gemoppelt ist überflüssig." }
    },
    {
      "woche": 2,
      "tag": 2,
      "titel": "Mein & dein",
      "kannZiel": "sagen, wem etwas gehört – mein Mann, deine Tochter",
      "vokabeln": [
        { "id": "w02-benim", "tr": "benim", "de": "mein(e)", "typ": "wort", "beispiel": { "tr": "Bu benim çayım!", "de": "Das ist mein Tee!" } },
        { "id": "w02-senin", "tr": "senin", "de": "dein(e)", "typ": "wort", "beispiel": { "tr": "Bu senin kahven.", "de": "Das ist dein Kaffee." } },
        { "id": "w02-es", "tr": "eş", "de": "Ehepartner (Mann / Frau)", "typ": "wort", "beispiel": { "tr": "Bu benim eşim, Pasha.", "de": "Das ist mein Mann, Pasha." } },
        { "id": "w02-babaanne", "tr": "babaanne", "de": "Oma (Mutter des Vaters)", "typ": "wort", "beispiel": { "tr": "Babanın annesi: babaanne.", "de": "Die Mutter des Vaters: babaanne." }, "merktipp": "babaanne = baba + anne: Papas Mama. Für Inaya ist Pashas Mama die babaanne." },
        { "id": "w02-anneanne", "tr": "anneanne", "de": "Oma (Mutter der Mutter)", "typ": "wort", "beispiel": { "tr": "Annenin annesi: anneanne.", "de": "Die Mutter der Mutter: anneanne." }, "merktipp": "anneanne = anne + anne: Mamas Mama. Logisch, oder?" },
        { "id": "w02-dede", "tr": "dede", "de": "Opa", "typ": "wort", "beispiel": { "tr": "Dede ve torun çok mutlu.", "de": "Opa und Enkelkind sind sehr glücklich." } },
        { "id": "w02-torun", "tr": "torun", "de": "Enkel / Enkelin", "typ": "wort", "beispiel": { "tr": "Inaya, babaannesinin torunu.", "de": "Inaya ist die Enkelin ihrer Oma." } },
        { "id": "w02-arkadas", "tr": "arkadaş", "de": "Freund / Freundin", "typ": "wort", "beispiel": { "tr": "Elif benim arkadaşım.", "de": "Elif ist meine Freundin." } },
        { "id": "w02-fotograf", "tr": "fotoğraf", "de": "Foto", "typ": "wort", "beispiel": { "tr": "Bu fotoğraf çok güzel.", "de": "Dieses Foto ist sehr schön." }, "merktipp": "Klingt wie „Fotograf“ – heißt aber einfach „Foto“." }
      ],
      "grammatik": {
        "titel": "mein = -(ı)m, dein = -(ı)n",
        "erklaerung": [
          "„Mein“ und „dein“ sind Endungen: anne → annem (meine Mutter), annen (deine Mutter).",
          "Nach Konsonant kommt ein Vokal dazu (4-fach): çay → çayım, kız → kızım, arkadaş → arkadaşım.",
          "benim / senin davor ist möglich, betont aber: benim kızım = MEINE Tochter.",
          "Endet ein Wort auf k und es kommt ein Vokal dazu, wird k zu ğ: çocuk → çocuğum, köpek → köpeğim."
        ],
        "tabelle": {
          "kopf": ["", "mein", "dein"],
          "zeilen": [
            ["anne", "annem", "annen"],
            ["çay", "çayım", "çayın"],
            ["kız", "kızım", "kızın"],
            ["eş", "eşim", "eşin"],
            ["çocuk", "çocuğum", "çocuğun"]
          ]
        },
        "beispiele": [
          { "tr": "Bu benim eşim.", "de": "Das ist mein Mann." },
          { "tr": "Bu senin kızın mı?", "de": "Ist das deine Tochter?" },
          { "tr": "Elif benim arkadaşım.", "de": "Elif ist meine Freundin." }
        ]
      },
      "dialog": {
        "titel": "Fotos auf dem Handy",
        "zeilen": [
          { "sprecher": "Elif", "tr": "Bu fotoğraf çok güzel! Bu kim?", "de": "Das Foto ist so schön! Wer ist das?" },
          { "sprecher": "Sherin", "tr": "Bu benim eşim, Pasha.", "de": "Das ist mein Mann, Pasha." },
          { "sprecher": "Elif", "tr": "Bu da senin kızın mı?", "de": "Und ist das deine Tochter?" },
          { "sprecher": "Sherin", "tr": "Evet, kızım Inaya.", "de": "Ja, meine Tochter Inaya." },
          { "sprecher": "Elif", "tr": "Ya bu?", "de": "Und wer ist das?" },
          { "sprecher": "Sherin", "tr": "Bu Inaya'nın babaannesi.", "de": "Das ist Inayas Oma – Pashas Mama." },
          { "sprecher": "Elif", "tr": "Çok tatlı bir aile!", "de": "So eine süße Familie!" }
        ]
      },
      "uebungen": [
        { "art": "auswahl_de_tr", "vokabel": "w02-es" },
        { "art": "luecke", "satz": "Bu benim kız___.", "loesung": "ım", "optionen": ["ım", "im", "um", "üm"], "de": "Das ist meine Tochter.", "hinweis": "kız – letzter Vokal ı" },
        { "art": "zuordnen", "vokabeln": ["w02-babaanne", "w02-anneanne", "w02-dede", "w02-torun"] },
        { "art": "hoeren", "vokabel": "w02-arkadas" },
        { "art": "luecke", "satz": "Bu senin anne___ mi?", "loesung": "n", "optionen": ["n", "in", "m"], "de": "Ist das deine Mutter?", "hinweis": "anne endet auf Vokal" },
        { "art": "satzbau", "tr": "Bu benim eşim, Pasha.", "de": "Das ist mein Mann, Pasha." },
        { "art": "auswahl_tr_de", "vokabel": "w02-senin" },
        { "art": "luecke", "satz": "Elif benim arkadaş___.", "loesung": "ım", "optionen": ["ım", "im", "m"], "de": "Elif ist meine Freundin.", "hinweis": "arkadaş – letzter Vokal a" },
        { "art": "tippen", "vokabel": "w02-dede" },
        { "art": "hoeren", "vokabel": "w02-fotograf" },
        { "art": "satzbau", "tr": "Bu senin kızın mı?", "de": "Ist das deine Tochter?" }
      ],
      "sprechauftrag": {
        "aufgabe": "Scrollt zusammen durch Familienfotos. Du zeigst und sagst: „Bu benim …“ – Pasha fragt nach: „Bu senin … mı?“ Benutze: eşim, kızım, arkadaşım, babaanne.",
        "mustersaetze": [
          { "tr": "Bu benim eşim.", "de": "Das ist mein Mann." },
          { "tr": "Bu Inaya'nın babaannesi.", "de": "Das ist Inayas Oma." },
          { "tr": "Bu senin annen mi?", "de": "Ist das deine Mutter?" }
        ]
      },
      "alltagssatz": { "tr": "Bu benim çayım!", "de": "Das ist mein Tee!", "wann": "Wenn Pasha (oder Inaya) heute nach deinem Glas greift." },
      "merktipp": { "titel": "Omas mit Bauplan", "text": "babaanne = baba + anne (Papas Mama), anneanne = anne + anne (Mamas Mama). Das Türkische sagt dir gleich, von welcher Seite die Oma kommt." }
    },
    {
      "woche": 2,
      "tag": 3,
      "titel": "Haben: var & yok",
      "kannZiel": "sagen, was du hast und was fehlt",
      "vokabeln": [
        { "id": "w02-var", "tr": "var", "de": "es gibt / ist da", "typ": "wort", "beispiel": { "tr": "Evde çay var.", "de": "Zu Hause ist Tee da." } },
        { "id": "w02-yok", "tr": "yok", "de": "es gibt nicht / ist nicht da", "typ": "wort", "beispiel": { "tr": "Süt yok!", "de": "Es ist keine Milch da!" } },
        { "id": "w02-bir-kizim-var", "tr": "Bir kızım var.", "de": "Ich habe eine Tochter.", "typ": "chunk", "beispiel": { "tr": "Bir kızım var. Onun adı Inaya.", "de": "Ich habe eine Tochter. Sie heißt Inaya." } },
        { "id": "w02-bir-kopegimiz-var", "tr": "Bir köpeğimiz var.", "de": "Wir haben einen Hund.", "typ": "chunk", "beispiel": { "tr": "Bir köpeğimiz var. Adı Amani.", "de": "Wir haben einen Hund. Sie heißt Amani." } },
        { "id": "w02-kardesin-var-mi", "tr": "Kardeşin var mı?", "de": "Hast du Geschwister?", "typ": "chunk", "beispiel": { "tr": "Pasha, kardeşin var mı?", "de": "Pasha, hast du Geschwister?" } },
        { "id": "w02-zamanim-yok", "tr": "Zamanım yok.", "de": "Ich habe keine Zeit.", "typ": "chunk", "beispiel": { "tr": "Bugün zamanım yok.", "de": "Heute habe ich keine Zeit." } },
        { "id": "w02-sorun-yok", "tr": "Sorun yok.", "de": "Kein Problem.", "typ": "chunk", "beispiel": { "tr": "Sorun yok, tamam!", "de": "Kein Problem, alles gut!" } },
        { "id": "w02-ev", "tr": "ev", "de": "Haus / Zuhause", "typ": "wort", "beispiel": { "tr": "Bu bizim evimiz.", "de": "Das ist unser Zuhause." }, "merktipp": "ev = Haus → „Eva ist zu Hause.“" }
      ],
      "grammatik": {
        "titel": "Haben ohne „haben“",
        "erklaerung": [
          "Türkisch hat kein Verb für „haben“. Man sagt: „Meine Tochter ist vorhanden“ – Bir kızım var.",
          "var = es gibt / ist da. yok = gibt es nicht / ist nicht da.",
          "Haben = Besitz-Endung + var: kızım var (ich habe eine Tochter), zamanın var (du hast Zeit).",
          "Frage: … var mı? – Antwort: Var. oder Yok.",
          "unser = -(ı)mız / -(i)miz: köpek → köpeğimiz (unser Hund), ev → evimiz."
        ],
        "tabelle": {
          "kopf": ["", "haben", "nicht haben"],
          "zeilen": [
            ["ich", "zamanım var", "zamanım yok"],
            ["du", "zamanın var", "zamanın yok"],
            ["wir", "köpeğimiz var", "köpeğimiz yok"]
          ]
        },
        "beispiele": [
          { "tr": "Bir kızım var.", "de": "Ich habe eine Tochter." },
          { "tr": "Zamanın var mı? – Yok.", "de": "Hast du Zeit? – Nein." },
          { "tr": "Evde süt yok.", "de": "Zu Hause ist keine Milch." }
        ]
      },
      "dialog": {
        "titel": "Einkaufsliste per Telefon",
        "zeilen": [
          { "sprecher": "Pasha", "tr": "Evde süt var mı?", "de": "Haben wir Milch zu Hause?" },
          { "sprecher": "Sherin", "tr": "Hayır, süt yok.", "de": "Nein, keine Milch." },
          { "sprecher": "Pasha", "tr": "Ekmek var mı?", "de": "Ist Brot da?" },
          { "sprecher": "Sherin", "tr": "Ekmek var. Ama Inaya'nın bezi yok!", "de": "Brot ist da. Aber Inaya hat keine Windeln mehr!" },
          { "sprecher": "Pasha", "tr": "Tamam, sorun yok. Ben alırım.", "de": "Okay, kein Problem. Ich hol welche." },
          { "sprecher": "Sherin", "tr": "Amani'nin maması da yok!", "de": "Und Amanis Futter ist auch alle!" },
          { "sprecher": "Pasha", "tr": "Tamam, onu da alırım.", "de": "Okay, das hol ich auch." }
        ]
      },
      "uebungen": [
        { "art": "auswahl_tr_de", "vokabel": "w02-var" },
        { "art": "auswahl_tr_de", "vokabel": "w02-yok" },
        { "art": "hoeren", "vokabel": "w02-bir-kizim-var" },
        { "art": "satzbau", "tr": "Bir köpeğimiz var.", "de": "Wir haben einen Hund." },
        { "art": "luecke", "satz": "Bugün zaman___ yok.", "loesung": "ım", "optionen": ["ım", "ın", "imiz"], "de": "Heute habe ich keine Zeit." },
        { "art": "auswahl_de_tr", "vokabel": "w02-sorun-yok" },
        { "art": "luecke", "satz": "Evde süt ___ mı?", "loesung": "var", "optionen": ["var", "yok", "değil"], "de": "Ist zu Hause Milch da?" },
        { "art": "hoeren", "vokabel": "w02-kardesin-var-mi" },
        { "art": "tippen", "vokabel": "w02-ev" },
        { "art": "satzbau", "tr": "Bir kızım var. Onun adı Inaya.", "de": "Ich habe eine Tochter. Sie heißt Inaya." },
        { "art": "zuordnen", "vokabeln": ["w02-var", "w02-yok", "w02-ev", "w02-zamanim-yok"] }
      ],
      "sprechauftrag": {
        "aufgabe": "Macht zusammen die Einkaufsliste – auf Türkisch. Öffne den Kühlschrank und sag, was da ist und was fehlt. Pasha fragt: „… var mı?“",
        "mustersaetze": [
          { "tr": "Süt yok. Ekmek var.", "de": "Keine Milch. Brot ist da." },
          { "tr": "Peynir var mı?", "de": "Ist Käse da?" },
          { "tr": "Sorun yok!", "de": "Kein Problem!" }
        ]
      },
      "alltagssatz": { "tr": "Sorun yok!", "de": "Kein Problem!", "wann": "Wenn heute etwas schiefgeht – ein Becher fällt um, Amani bellt. Locker bleiben auf Türkisch." },
      "merktipp": { "titel": "var & yok überall", "text": "var und yok sind zwei der wichtigsten Wörter im Türkischen. Mit ihnen kannst du sagen, was es gibt, was fehlt und was du hast – ganz ohne Verb." }
    },
    {
      "woche": 2,
      "tag": 4,
      "titel": "Zahlen bis 100",
      "kannZiel": "Zahlen bis hundert verstehen und sagen",
      "vokabeln": [
        { "id": "w02-yirmi", "tr": "yirmi", "de": "zwanzig", "typ": "wort", "beispiel": { "tr": "Yirmi bir, yirmi iki …", "de": "Einundzwanzig, zweiundzwanzig …" } },
        { "id": "w02-otuz", "tr": "otuz", "de": "dreißig", "typ": "wort", "beispiel": { "tr": "Otuz derece! Çok sıcak.", "de": "30 Grad! Sehr heiß." } },
        { "id": "w02-kirk", "tr": "kırk", "de": "vierzig", "typ": "wort", "beispiel": { "tr": "Kırk euro.", "de": "Vierzig Euro." } },
        { "id": "w02-elli", "tr": "elli", "de": "fünfzig", "typ": "wort", "beispiel": { "tr": "Elli kilometre.", "de": "Fünfzig Kilometer." } },
        { "id": "w02-altmis", "tr": "altmış", "de": "sechzig", "typ": "wort", "beispiel": { "tr": "Bir saatte altmış dakika var.", "de": "Eine Stunde hat sechzig Minuten." }, "merktipp": "altmış steckt altı (6) drin – sechzig." },
        { "id": "w02-yetmis", "tr": "yetmiş", "de": "siebzig", "typ": "wort", "beispiel": { "tr": "Yetmiş beş.", "de": "Fünfundsiebzig." }, "merktipp": "yetmiş steckt yedi (7) drin – siebzig." },
        { "id": "w02-seksen", "tr": "seksen", "de": "achtzig", "typ": "wort", "beispiel": { "tr": "Seksen sekiz.", "de": "Achtundachtzig." }, "merktipp": "seksen kommt von sekiz (8) – achtzig." },
        { "id": "w02-doksan", "tr": "doksan", "de": "neunzig", "typ": "wort", "beispiel": { "tr": "Doksan dokuz.", "de": "Neunundneunzig." }, "merktipp": "doksan kommt von dokuz (9) – neunzig." },
        { "id": "w02-yuz", "tr": "yüz", "de": "hundert", "typ": "wort", "beispiel": { "tr": "Yüz euro çok para!", "de": "Hundert Euro sind viel Geld!" } },
        { "id": "w02-kac", "tr": "kaç?", "de": "wie viele? / wie viel?", "typ": "wort", "beispiel": { "tr": "Bu kaç euro?", "de": "Wie viel Euro kostet das?" } }
      ],
      "grammatik": {
        "titel": "Zehner + Einer",
        "erklaerung": [
          "Zahlen baut man wie Lego von groß nach klein: Zehner + Einer, ohne „und“.",
          "yirmi bir = 21, otuz beş = 35, doksan dokuz = 99. Andersherum als im Deutschen!",
          "11 bis 19 genauso: on bir (11), on beş (15), on dokuz (19).",
          "Ab 60 hört man die Einer im Zehner: altı → altmış, yedi → yetmiş, sekiz → seksen, dokuz → doksan."
        ],
        "tabelle": {
          "kopf": ["Zahl", "Türkisch"],
          "zeilen": [
            ["12", "on iki"],
            ["21", "yirmi bir"],
            ["35", "otuz beş"],
            ["48", "kırk sekiz"],
            ["67", "altmış yedi"],
            ["99", "doksan dokuz"]
          ]
        },
        "beispiele": [
