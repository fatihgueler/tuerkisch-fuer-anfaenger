          { "sprecher": "Pasha", "tr": "Amani kanepede uyuyor.", "de": "Amani schläft auf dem Sofa." },
          { "sprecher": "Sherin", "tr": "Amani! Kanepe senin yatağın değil!", "de": "Amani! Das Sofa ist nicht dein Bett!" }
        ]
      },
