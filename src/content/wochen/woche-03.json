        { "id": "w03-oda", "tr": "oda", "de": "Zimmer", "typ": "wort", "beispiel": { "tr": "Inaya'nın odası çok güzel.", "de": "Inayas Zimmer ist sehr schön." } },
        { "id": "w03-mutfak", "tr": "mutfak", "de": "Küche", "typ": "wort", "beispiel": { "tr": "Pasha mutfakta.", "de": "Pasha ist in der Küche." } },
        { "id": "w03-banyo", "tr": "banyo", "de": "Bad", "typ": "wort", "beispiel": { "tr": "Banyo nerede?", "de": "Wo ist das Bad?" } },
