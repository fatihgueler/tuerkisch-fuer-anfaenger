        { "id": "w03-kasik", "tr": "kaşık", "de": "Löffel", "typ": "wort", "beispiel": { "tr": "Inaya'nın kaşığı yerde.", "de": "Inayas Löffel liegt auf dem Boden." } },
        { "id": "w03-emzik", "tr": "emzik", "de": "Schnuller", "typ": "wort", "beispiel": { "tr": "Emziği nerede?", "de": "Wo ist ihr Schnuller?" } },
        { "id": "w03-battaniye", "tr": "battaniye", "de": "Decke", "typ": "wort", "beispiel": { "tr": "Battaniye kanepede.", "de": "Die Decke liegt auf dem Sofa." } },
        { "id": "w03-mama-sandalyesi", "tr": "mama sandalyesi", "de": "Hochstuhl", "typ": "chunk", "beispiel": { "tr": "Inaya mama sandalyesinde.", "de": "Inaya sitzt im Hochstuhl." } },
