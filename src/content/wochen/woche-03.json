          ]
        },
        "beispiele": [
          { "tr": "Bu masa çok büyük.", "de": "Dieser Tisch ist sehr groß." },
          { "tr": "Şu ne?", "de": "Was ist das da?" },
          { "tr": "O kapı açık.", "de": "Die Tür dort ist offen." }
        ]
      },
      "dialog": {
        "titel": "Aufräumen am Abend",
        "zeilen": [
          { "sprecher": "Sherin", "tr": "Pasha, bu ne?", "de": "Pasha, was ist das?" },
          { "sprecher": "Pasha", "tr": "Bu Inaya'nın oyuncağı.", "de": "Das ist Inayas Spielzeug." },
