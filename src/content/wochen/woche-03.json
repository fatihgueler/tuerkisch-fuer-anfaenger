          { "sprecher": "Sherin", "tr": "Yok … Ah! Kapının yanında!", "de": "Nein … Ah! Neben der Tür!" },
          { "sprecher": "Pasha", "tr": "Süper. Hadi, gidiyoruz!", "de": "Super. Komm, wir gehen!" }
