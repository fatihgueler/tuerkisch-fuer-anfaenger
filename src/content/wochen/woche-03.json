        { "art": "luecke", "satz": "Araba ev___ önünde.", "loesung": "in", "optionen": ["in", "nin", "ın"], "de": "Das Auto steht vor dem Haus.", "hinweis": "ev endet auf Konsonant, Vokal e" },
