        { "art": "tippen", "vokabel": "w03-canta" },
        { "art": "satzbau", "tr": "Top kanepenin altında.", "de": "Der Ball ist unter dem Sofa." },
        { "art": "auswahl_de_tr", "vokabel": "w03-yaninda" }
      ],
      "sprechauftrag": {
        "aufgabe": "Pasha versteckt drei Dinge (Schlüssel, Inayas Spielzeug, eine Tasse). Du fragst „… nerede?“ – er antwortet nur mit Ortsangaben auf Türkisch. Du sagst laut, wo du es gefunden hast.",
        "mustersaetze": [
