        { "id": "w03-icinde", "tr": "içinde", "de": "in / drin", "typ": "wort", "beispiel": { "tr": "Anahtar çantanın içinde.", "de": "Der Schlüssel ist in der Tasche." } },
        { "id": "w03-onunde", "tr": "önünde", "de": "vor", "typ": "wort", "beispiel": { "tr": "Araba evin önünde.", "de": "Das Auto steht vor dem Haus." } },
