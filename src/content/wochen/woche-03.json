      ],
      "grammatik": {
        "titel": "Lokativ -da / -de = wo?",
        "erklaerung": [
          "Lokativ heißt einfach: wo? Die Endung -da/-de bedeutet „in, auf, bei“.",
          "Nach a, ı, o, u → -da (odada), nach e, i, ö, ü → -de (evde).",
          "Nach harten Konsonanten (ç, f, h, k, p, s, ş, t) wird d zu t: mutfakta, parkta.",
          "Mit Personen-Endung: evdeyim (ich bin zu Hause), mutfaktayım (ich bin in der Küche)."
        ],
        "tabelle": {
          "kopf": ["Wort", "wo?"],
          "zeilen": [
            ["ev", "evde"],
            ["oda", "odada"],
            ["salon", "salonda"],
            ["bahçe", "bahçede"],
            ["mutfak", "mutfakta"],
            ["park", "parkta"]
          ]
        },
        "beispiele": [
          { "tr": "Pasha mutfakta.", "de": "Pasha ist in der Küche." },
          { "tr": "Amani bahçede.", "de": "Amani ist im Garten." },
          { "tr": "Bugün evdeyim.", "de": "Heute bin ich zu Hause." }
        ]
      },
      "dialog": {
        "titel": "Wo ist wer?",
        "zeilen": [
          { "sprecher": "Pasha", "tr": "Sherin, neredesin?", "de": "Sherin, wo bist du?" },
          { "sprecher": "Sherin", "tr": "Mutfaktayım!", "de": "In der Küche!" },
          { "sprecher": "Pasha", "tr": "Inaya nerede?", "de": "Wo ist Inaya?" },
          { "sprecher": "Sherin", "tr": "Salonda. Amani de orada.", "de": "Im Wohnzimmer. Amani ist auch da." },
          { "sprecher": "Pasha", "tr": "Peki, telefonum nerede?", "de": "Und wo ist mein Handy?" },
          { "sprecher": "Sherin", "tr": "Banyoda!", "de": "Im Bad!" },
          { "sprecher": "Pasha", "tr": "Banyoda mı? Gerçekten mi?", "de": "Im Bad? Echt jetzt?" },
          { "sprecher": "Sherin", "tr": "Evet! Hep orada!", "de": "Ja! Da liegt es immer!" }
        ]
      },
      "uebungen": [
        { "art": "zuordnen", "vokabeln": ["w03-oda", "w03-mutfak", "w03-banyo", "w03-bahce"] },
        { "art": "luecke", "satz": "Pasha mutfak___.", "loesung": "ta", "optionen": ["ta", "da", "te", "de"], "de": "Pasha ist in der Küche.", "hinweis": "mutfak endet auf k (hart)" },
        { "art": "auswahl_tr_de", "vokabel": "w03-salon" },
        { "art": "luecke", "satz": "Amani bahçe___.", "loesung": "de", "optionen": ["de", "da", "te"], "de": "Amani ist im Garten.", "hinweis": "bahçe – letzter Vokal e" },
