      "dialog": {
        "titel": "Schlüsselsuche",
        "zeilen": [
          { "sprecher": "Sherin", "tr": "Pasha, anahtarım nerede?", "de": "Pasha, wo ist mein Schlüssel?" },
          { "sprecher": "Pasha", "tr": "Masanın üstünde değil mi?", "de": "Liegt er nicht auf dem Tisch?" },
