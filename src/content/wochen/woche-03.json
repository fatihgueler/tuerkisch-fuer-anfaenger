        { "art": "luecke", "satz": "Inaya oda___.", "loesung": "da", "optionen": ["da", "de", "ta"], "de": "Inaya ist im Zimmer." },
        { "art": "satzbau", "tr": "Amani salonda uyuyor.", "de": "Amani schläft im Wohnzimmer." },
        { "art": "tippen", "vokabel": "w03-burada" },
        { "art": "hoeren", "vokabel": "w03-orada" },
        { "art": "satzbau", "tr": "Bugün evdeyim.", "de": "Heute bin ich zu Hause." }
      ],
      "sprechauftrag": {
        "aufgabe": "Versteckspiel per Zuruf: Pasha geht in irgendeinen Raum und ruft „Neredeyim?“ (Wo bin ich?). Du rätst laut auf Türkisch. Dann tauscht ihr.",
        "mustersaetze": [
          { "tr": "Mutfakta mısın?", "de": "Bist du in der Küche?" },
          { "tr": "Banyodayım!", "de": "Ich bin im Bad!" },
          { "tr": "Inaya salonda.", "de": "Inaya ist im Wohnzimmer." }
        ]
      },
      "alltagssatz": { "tr": "Neredesin?", "de": "Wo bist du?", "wann": "Wenn du Pasha heute in der Wohnung suchst – ruf auf Türkisch." },
      "merktipp": { "titel": "Fıstıkçı Şahap", "text": "Türkische Kinder merken sich die harten Konsonanten mit „Fıstıkçı Şahap“ (Şahap, der Pistazienhändler): f, s, t, k, ç, ş, h, p. Danach wird -da zu -ta." }
    },
    {
