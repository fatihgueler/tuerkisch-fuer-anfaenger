    {
      "woche": 5,
      "tag": 1,
      "titel": "Nicht: -mıyor",
      "kannZiel": "sagen, was du nicht tust, verstehst oder weißt",
      "vokabeln": [
        { "id": "w05-anlamak", "tr": "anlamak", "de": "verstehen", "typ": "wort", "beispiel": { "tr": "Anlamıyorum.", "de": "Ich verstehe das nicht." } },
        { "id": "w05-bilmek", "tr": "bilmek", "de": "wissen / kennen", "typ": "wort", "beispiel": { "tr": "Bilmiyorum.", "de": "Ich weiß es nicht." } },
        { "id": "w05-sevmek", "tr": "sevmek", "de": "mögen / lieben", "typ": "wort", "beispiel": { "tr": "Inaya ıspanağı sevmiyor.", "de": "Inaya mag keinen Spinat." } },
        { "id": "w05-istemek", "tr": "istemek", "de": "wollen / möchten", "typ": "wort", "beispiel": { "tr": "Çay istiyor musun?", "de": "Möchtest du Tee?" } },
        { "id": "w05-beklemek", "tr": "beklemek", "de": "warten / erwarten", "typ": "wort", "beispiel": { "tr": "Seni bekliyorum.", "de": "Ich warte auf dich." } },
        { "id": "w05-dinlemek", "tr": "dinlemek", "de": "zuhören / hören (Musik)", "typ": "wort", "beispiel": { "tr": "Inaya müzik dinliyor.", "de": "Inaya hört Musik." } },
        { "id": "w05-bakmak", "tr": "bakmak", "de": "schauen", "typ": "wort", "beispiel": { "tr": "Bana bak!", "de": "Schau mich an!" } },
        { "id": "w05-hic", "tr": "hiç", "de": "gar nicht / überhaupt nicht", "typ": "wort", "beispiel": { "tr": "Hiç anlamıyorum!", "de": "Ich verstehe gar nichts!" } },
        { "id": "w05-artik", "tr": "artık", "de": "nicht mehr / jetzt (endlich)", "typ": "wort", "beispiel": { "tr": "Inaya artık emzik istemiyor.", "de": "Inaya will keinen Schnuller mehr." } }
      ],
      "grammatik": {
        "titel": "Verneinung: -mı- vor -yor",
        "erklaerung": [
          "„Nicht“ ist beim Verb ein Lego-Stein: -mı/-mi/-mu/-mü direkt vor -yor.",
          "anla + mı + yor + um = anlamıyorum (ich verstehe nicht).",
          "Den Stein kennst du schon aus Woche 0: anlamadım (nicht verstanden).",
          "hiç verstärkt: Hiç bilmiyorum. = Ich habe keine Ahnung."
        ],
        "tabelle": {
          "kopf": ["Grundform", "ich … nicht"],
          "zeilen": [
            ["anlamak", "anlamıyorum"],
            ["bilmek", "bilmiyorum"],
            ["uyumak", "uyumuyorum"],
            ["görmek", "görmüyorum"],
            ["istemek", "istemiyorum"]
          ]
        },
        "beispiele": [
          { "tr": "Bilmiyorum.", "de": "Ich weiß es nicht." },
          { "tr": "Inaya uyumuyor.", "de": "Inaya schläft nicht." },
          { "tr": "Hiç anlamıyorum!", "de": "Ich verstehe gar nichts!" }
        ]
      },
      "dialog": {
        "titel": "Telefonat mit Schwiegermama",
        "zeilen": [
          { "sprecher": "Sherin", "tr": "Pasha, annen ne diyor? Hiç anlamıyorum!", "de": "Pasha, was sagt deine Mutter? Ich verstehe gar nichts!" },
          { "sprecher": "Pasha", "tr": "Bizi pazar günü bekliyor.", "de": "Sie erwartet uns am Sonntag." },
          { "sprecher": "Sherin", "tr": "Bu pazar mı? Bilmiyorum … Inaya hasta.", "de": "Diesen Sonntag? Ich weiß nicht … Inaya ist krank." },
          { "sprecher": "Pasha", "tr": "Tamam, sorun yok. Annem anlıyor.", "de": "Okay, kein Problem. Mama versteht das." },
          { "sprecher": "Sherin", "tr": "Annen kızmıyor mu?", "de": "Ist deine Mutter nicht sauer?" },
          { "sprecher": "Pasha", "tr": "Hayır, kızmıyor. Geçmiş olsun diyor.", "de": "Nein. Sie sagt „Gute Besserung“." }
        ]
      },
      "uebungen": [
        { "art": "zuordnen", "vokabeln": ["w05-anlamak", "w05-bilmek", "w05-sevmek", "w05-istemek"] },
        { "art": "luecke", "satz": "Anla___rum.", "loesung": "mıyo", "optionen": ["mıyo", "miyo", "ıyo"], "de": "Ich verstehe das nicht." },
        { "art": "luecke", "satz": "Bil___rum.", "loesung": "miyo", "optionen": ["miyo", "mıyo", "iyo"], "de": "Ich weiß es nicht." },
        { "art": "hoeren", "vokabel": "w05-beklemek" },
        { "art": "auswahl_tr_de", "vokabel": "w05-artik" },
        { "art": "satzbau", "tr": "Hiç anlamıyorum!", "de": "Ich verstehe gar nichts!" },
        { "art": "auswahl_de_tr", "vokabel": "w05-bakmak" },
        { "art": "luecke", "satz": "Inaya uyu___r.", "loesung": "muyo", "optionen": ["muyo", "mıyo", "miyo"], "de": "Inaya schläft nicht." },
        { "art": "tippen", "vokabel": "w05-hic" },
        { "art": "hoeren", "vokabel": "w05-dinlemek" }
      ],
      "sprechauftrag": {
        "aufgabe": "Spielt „Stimmt nicht!“: Pasha behauptet Dinge über dich („Kahve seviyorsun.“). Du antwortest mit Evet oder verneinst mit -mıyor. Danach tauscht ihr.",
        "mustersaetze": [
          { "tr": "Hayır, kahve sevmiyorum.", "de": "Nein, ich mag keinen Kaffee." },
          { "tr": "Bilmiyorum.", "de": "Ich weiß es nicht." },
          { "tr": "Anlamıyorum, tekrar eder misin?", "de": "Ich verstehe nicht, kannst du das wiederholen?" }
        ]
      },
      "alltagssatz": { "tr": "Bilmiyorum.", "de": "Ich weiß es nicht.", "wann": "Wenn Pasha heute fragt, wo etwas ist – ehrlich auf Türkisch." },
      "merktipp": { "titel": "Ein Stein für „nicht“", "text": "-ma-/-me- steckt in allem, was „nicht“ ist: anla-ma-dım, anla-mı-yorum, bil-mi-yorum. Wenn du „ma/mi“ im Verb hörst, hör genau hin: Da sagt jemand Nein." }
    },
