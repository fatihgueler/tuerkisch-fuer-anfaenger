            ["du", "anlıyor musun?"],
            ["er/sie", "anlıyor mu?"],
            ["wir", "anlıyor muyuz?"]
          ]
        },
        "beispiele": [
          { "tr": "Beni duyuyor musun?", "de": "Hörst du mich?" },
          { "tr": "Inaya hâlâ uyuyor mu?", "de": "Schläft Inaya immer noch?" },
          { "tr": "Anlıyor musun?", "de": "Verstehst du?" }
        ]
      },
      "dialog": {
        "titel": "Anruf aus dem Büro",
        "zeilen": [
          { "sprecher": "Sherin", "tr": "Alo? Pasha, beni duyuyor musun?", "de": "Hallo? Pasha, hörst du mich?" },
          { "sprecher": "Pasha", "tr": "Evet, duyuyorum. Inaya ağlıyor mu?", "de": "Ja, ich höre dich. Weint Inaya?" },
          { "sprecher": "Sherin", "tr": "Evet, ağlıyor. Galiba diş çıkarıyor.", "de": "Ja. Ich glaube, sie zahnt." },
          { "sprecher": "Pasha", "tr": "Eve geliyorum. Bir şey istiyor musun?", "de": "Ich komme nach Hause. Brauchst du etwas?" },
          { "sprecher": "Sherin", "tr": "Evet! Çikolata!", "de": "Ja! Schokolade!" },
          { "sprecher": "Pasha", "tr": "Tamam. Inaya hâlâ ağlıyor mu?", "de": "Okay. Weint Inaya immer noch?" },
          { "sprecher": "Sherin", "tr": "Hayır, artık gülüyor!", "de": "Nein, jetzt lacht sie!" }
        ]
      },
      "uebungen": [
