          { "tr": "Amani'yi görüyor musun?", "de": "Siehst du Amani?" }
        ]
      },
      "alltagssatz": { "tr": "Beni duyuyor musun?", "de": "Hörst du mich?", "wann": "Wenn Pasha heute wieder mit Kopfhörern im Ohr dasitzt." },
      "merktipp": { "titel": "Immer „mu“ nach -yor", "text": "Bei -yor-Fragen musst du nicht über Vokalharmonie nachdenken: Nach -yor kommt immer mu. Geliyor mu, biliyor mu, anlıyor mu." }
