        { "id": "w05-duymak", "tr": "duymak", "de": "hören (wahrnehmen)", "typ": "wort", "beispiel": { "tr": "Beni duyuyor musun?", "de": "Hörst du mich?" } },
        { "id": "w05-gormek", "tr": "görmek", "de": "sehen", "typ": "wort", "beispiel": { "tr": "Amani'yi görüyor musun?", "de": "Siehst du Amani?" } },
        { "id": "w05-aglamak", "tr": "ağlamak", "de": "weinen", "typ": "wort", "beispiel": { "tr": "Inaya ağlıyor mu?", "de": "Weint Inaya?" } },
        { "id": "w05-gulmek", "tr": "gülmek", "de": "lachen", "typ": "wort", "beispiel": { "tr": "Inaya gülüyor!", "de": "Inaya lacht!" } },
        { "id": "w05-hala", "tr": "hâlâ", "de": "immer noch", "typ": "wort", "beispiel": { "tr": "Hâlâ uyuyor mu?", "de": "Schläft sie immer noch?" } },
        { "id": "w05-henuz", "tr": "henüz", "de": "noch nicht / gerade erst", "typ": "wort", "beispiel": { "tr": "Henüz bilmiyorum.", "de": "Ich weiß es noch nicht." } }
      ],
      "grammatik": {
        "titel": "Frage: -yor + mu + Person",
        "erklaerung": [
          "Fragen mit -yor: Das Verb bleibt, dahinter kommt mu (immer mu, weil -yor ein o hat).",
