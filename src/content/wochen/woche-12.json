      "sprechauftrag": {
        "aufgabe": "Plant zusammen eine kleine Feier (z. B. ein Abendessen mit Freunden) auf Türkisch: Wen ladet ihr ein, wer macht was, was gibt es zu essen? Jeder übernimmt drei Aufgaben – in der Zukunft gesagt.",
        "mustersaetze": [
          { "tr": "Elif'i davet edeceğiz.", "de": "Wir laden Elif ein." },
          { "tr": "Ben çorba yapacağım.", "de": "Ich mache Suppe." },
          { "tr": "Sen tatlıyı alacaksın.", "de": "Du besorgst den Nachtisch." }
        ]
      },
      "alltagssatz": { "tr": "Ben … yapacağım, sen … yapacaksın.", "de": "Ich mache …, du machst …", "wann": "Beim nächsten Aufgabenverteilen im Haushalt." },
      "merktipp": { "titel": "Falsche Freunde", "text": "pasta = Torte (nicht Nudeln!), makarna = Nudeln. Und bei einer Einladung bringt man in der Türkei fast immer etwas Süßes mit." }
