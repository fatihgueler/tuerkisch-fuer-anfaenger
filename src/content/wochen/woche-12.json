{
  "woche": 12,
  "lektionen": [
    {
      "woche": 12,
      "tag": 1,
      "titel": "Morgen: -acak / -ecek",
      "kannZiel": "sagen, was du morgen machen wirst",
      "vokabeln": [
        { "id": "w12-yarin-sabah", "tr": "yarın sabah", "de": "morgen früh", "typ": "chunk", "beispiel": { "tr": "Yarın sabah erken kalkacağım.", "de": "Morgen früh stehe ich früh auf." } },
        { "id": "w12-obur-gun", "tr": "öbür gün", "de": "übermorgen", "typ": "chunk", "beispiel": { "tr": "Öbür gün Elif gelecek.", "de": "Übermorgen kommt Elif." } },
        { "id": "w12-gelecek-hafta", "tr": "gelecek hafta", "de": "nächste Woche", "typ": "chunk", "beispiel": { "tr": "Gelecek hafta doktora gideceğiz.", "de": "Nächste Woche gehen wir zum Arzt." } },
        { "id": "w12-plan", "tr": "plan", "de": "Plan", "typ": "wort", "beispiel": { "tr": "Yarın için planın var mı?", "de": "Hast du einen Plan für morgen?" } },
        { "id": "w12-belki", "tr": "belki", "de": "vielleicht", "typ": "wort", "beispiel": { "tr": "Belki parka gideriz.", "de": "Vielleicht gehen wir in den Park." } },
        { "id": "w12-kesin", "tr": "kesin", "de": "sicher / bestimmt", "typ": "wort", "beispiel": { "tr": "Kesin geleceğim!", "de": "Ich komme ganz bestimmt!" } },
        { "id": "w12-herhalde", "tr": "herhalde", "de": "wahrscheinlich", "typ": "wort", "beispiel": { "tr": "Herhalde yağmur yağacak.", "de": "Wahrscheinlich wird es regnen." } },
        { "id": "w12-ne-yapacaksin", "tr": "Ne yapacaksın?", "de": "Was wirst du machen?", "typ": "chunk", "beispiel": { "tr": "Yarın ne yapacaksın?", "de": "Was machst du morgen?" } },
        { "id": "w12-program", "tr": "program", "de": "Programm / Zeitplan", "typ": "wort", "beispiel": { "tr": "Yarınki program ne?", "de": "Was steht morgen an?" } }
      ],
      "grammatik": {
        "titel": "Zukunft: -acak / -ecek",
        "erklaerung": [
          "Zukunft = Stamm + -acak/-ecek (2-fach) + Person: gel + eceğ + im = geleceğim (ich werde kommen).",
          "Vor einem Vokal wird k zu ğ: yapacağım, geleceğiz – aber yapacaksın, gelecek.",
          "Nach Vokal mit y: uyu → uyuyacağım, bekle → bekleyeceğim.",
          "gitmek und etmek werden weich: gideceğim, edeceğim."
        ],
        "tabelle": {
          "kopf": ["", "gelmek", "yapmak", "uyumak"],
          "zeilen": [
            ["ich", "geleceğim", "yapacağım", "uyuyacağım"],
            ["du", "geleceksin", "yapacaksın", "uyuyacaksın"],
            ["er/sie", "gelecek", "yapacak", "uyuyacak"],
            ["wir", "geleceğiz", "yapacağız", "uyuyacağız"]
          ]
        },
        "beispiele": [
          { "tr": "Yarın ne yapacaksın?", "de": "Was machst du morgen?" },
          { "tr": "Öbür gün Elif gelecek.", "de": "Übermorgen kommt Elif." },
          { "tr": "Gelecek hafta doktora gideceğiz.", "de": "Nächste Woche gehen wir zum Arzt." }
        ]
      },
      "dialog": {
        "titel": "Pläne für morgen",
        "zeilen": [
          { "sprecher": "Pasha", "tr": "Yarın ne yapacaksın?", "de": "Was machst du morgen?" },
          { "sprecher": "Sherin", "tr": "Sabah markete gideceğim. Sonra Elif gelecek.", "de": "Morgens gehe ich zum Supermarkt. Dann kommt Elif." },
          { "sprecher": "Pasha", "tr": "Parka gidecek misiniz?", "de": "Geht ihr in den Park?" },
          { "sprecher": "Sherin", "tr": "Belki. Ama herhalde yağmur yağacak.", "de": "Vielleicht. Aber wahrscheinlich regnet es." },
          { "sprecher": "Pasha", "tr": "Ben akşam erken geleceğim. Yemek yapacağım.", "de": "Ich komme abends früh. Ich koche." },
          { "sprecher": "Sherin", "tr": "Kesin mi? Söz mü?", "de": "Sicher? Versprochen?" }
        ]
      },
      "uebungen": [
        { "art": "zuordnen", "vokabeln": ["w12-yarin-sabah", "w12-obur-gun", "w12-gelecek-hafta", "w12-belki"] },
        { "art": "luecke", "satz": "Yarın markete gide___.", "loesung": "ceğim", "optionen": ["ceğim", "cağım", "yorum"], "de": "Morgen gehe ich zum Supermarkt." },
        { "art": "luecke", "satz": "Akşam yemek yap___.", "loesung": "acağım", "optionen": ["acağım", "eceğim", "tım"], "de": "Abends werde ich kochen." },
        { "art": "hoeren", "vokabel": "w12-ne-yapacaksin" },
        { "art": "auswahl_de_tr", "vokabel": "w12-herhalde" },
        { "art": "satzbau", "tr": "Öbür gün Elif gelecek.", "de": "Übermorgen kommt Elif." },
        { "art": "auswahl_tr_de", "vokabel": "w12-kesin" },
        { "art": "luecke", "satz": "Inaya erken uyu___.", "loesung": "yacak", "optionen": ["yacak", "acak", "yecek"], "de": "Inaya wird früh schlafen." },
        { "art": "tippen", "vokabel": "w12-plan" },
        { "art": "hoeren", "vokabel": "w12-program" }
      ],
      "sprechauftrag": {
        "aufgabe": "Geht den morgigen Tag auf Türkisch durch – diesmal in der Zukunft. Jeder sagt fünf Dinge, die er morgen machen wird. Einmal mit belki, einmal mit kesin.",
        "mustersaetze": [
          { "tr": "Yarın sabah erken kalkacağım.", "de": "Morgen früh stehe ich früh auf." },
          { "tr": "Belki Elif'le buluşacağım.", "de": "Vielleicht treffe ich Elif." },
          { "tr": "Kesin Türkçe çalışacağım!", "de": "Ich lerne ganz bestimmt Türkisch!" }
        ]
      },
      "alltagssatz": { "tr": "Yarın ne yapacaksın?", "de": "Was machst du morgen?", "wann": "Heute Abend zu Pasha – und dann der Plan auf Türkisch." },
      "merktipp": { "titel": "-acak klingt nach „Zukunft“", "text": "geleceğim, yapacağım, gideceğiz – das „cak/cek“ ist dein Zukunfts-Signal. Übrigens heißt gelecek allein „Zukunft“ – und auch „nächste“: gelecek hafta = nächste Woche." }
    },
