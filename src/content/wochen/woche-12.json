    {
      "woche": 12,
      "tag": 3,
      "titel": "Versprochen! – Zukunft verneint & gefragt",
      "kannZiel": "Versprechen geben und nach Plänen fragen",
      "vokabeln": [
        { "id": "w12-soz-vermek", "tr": "söz vermek", "de": "versprechen", "typ": "chunk", "beispiel": { "tr": "Söz veriyorum, geç kalmayacağım.", "de": "Ich verspreche, ich komme nicht zu spät." } },
        { "id": "w12-soz", "tr": "Söz!", "de": "Versprochen!", "typ": "chunk", "beispiel": { "tr": "Yarın erken geleceğim. Söz!", "de": "Morgen komme ich früh. Versprochen!" } },
        { "id": "w12-gec-kalmak", "tr": "geç kalmak", "de": "zu spät kommen", "typ": "chunk", "beispiel": { "tr": "Yine geç kaldın!", "de": "Du bist schon wieder zu spät!" } },
        { "id": "w12-zamaninda", "tr": "zamanında", "de": "pünktlich", "typ": "wort", "beispiel": { "tr": "Bu sefer zamanında geleceğim.", "de": "Diesmal komme ich pünktlich." } },
        { "id": "w12-merak-etme", "tr": "Merak etme!", "de": "Keine Sorge!", "typ": "chunk", "beispiel": { "tr": "Merak etme, her şey yolunda.", "de": "Keine Sorge, alles in Ordnung." } },
        { "id": "w12-emin-misin", "tr": "Emin misin?", "de": "Bist du sicher?", "typ": "chunk", "beispiel": { "tr": "Emin misin? Gerçekten gelecek misin?", "de": "Bist du sicher? Kommst du wirklich?" } },
        { "id": "w12-gorecegiz", "tr": "Göreceğiz.", "de": "Mal sehen.", "typ": "chunk", "beispiel": { "tr": "Belki. Göreceğiz.", "de": "Vielleicht. Mal sehen." } },
        { "id": "w12-asla", "tr": "asla", "de": "niemals", "typ": "wort", "beispiel": { "tr": "Seni asla unutmayacağım.", "de": "Ich werde dich niemals vergessen." } }
      ],
      "grammatik": {
        "titel": "nicht & Frage in der Zukunft",
        "erklaerung": [
          "Nicht: -ma/-me + y + acak/ecek: gelmeyeceğim (ich werde nicht kommen), yapmayacağım.",
          "Frage: -acak + mı + Person: Gelecek misin? (Wirst du kommen?) Yapacak mıyız?",
          "Göreceğiz (wir werden sehen) = „Mal sehen“ – sehr häufig im Alltag."
        ],
        "tabelle": {
          "kopf": ["ja", "nein", "Frage"],
          "zeilen": [
            ["geleceğim", "gelmeyeceğim", "gelecek miyim?"],
            ["geleceksin", "gelmeyeceksin", "gelecek misin?"],
            ["gelecek", "gelmeyecek", "gelecek mi?"]
          ]
        },
        "beispiele": [
          { "tr": "Geç kalmayacağım, söz!", "de": "Ich komme nicht zu spät, versprochen!" },
          { "tr": "Yarın gelecek misin?", "de": "Kommst du morgen?" },
          { "tr": "Bilmiyorum, göreceğiz.", "de": "Weiß nicht, mal sehen." }
        ]
      },
      "dialog": {
        "titel": "Pasha und die Pünktlichkeit",
        "zeilen": [
          { "sprecher": "Sherin", "tr": "Yarın Elif'lere zamanında gidecek miyiz?", "de": "Kommen wir morgen pünktlich zu Elif?" },
          { "sprecher": "Pasha", "tr": "Tabii! Bu sefer geç kalmayacağım.", "de": "Klar! Diesmal komme ich nicht zu spät." },
          { "sprecher": "Sherin", "tr": "Emin misin?", "de": "Bist du sicher?" },
          { "sprecher": "Pasha", "tr": "Söz veriyorum. Saat ikide evde olacağım.", "de": "Ich verspreche es. Um zwei bin ich zu Hause." },
          { "sprecher": "Sherin", "tr": "Hmm … göreceğiz.", "de": "Hmm … mal sehen." },
          { "sprecher": "Pasha", "tr": "Merak etme, canım. Söz!", "de": "Keine Sorge, Schatz. Versprochen!" }
        ]
      },
      "uebungen": [
        { "art": "zuordnen", "vokabeln": ["w12-soz", "w12-merak-etme", "w12-emin-misin", "w12-gorecegiz"] },
        { "art": "luecke", "satz": "Geç kal___!", "loesung": "mayacağım", "optionen": ["mayacağım", "acağım", "madım"], "de": "Ich werde nicht zu spät kommen!" },
        { "art": "luecke", "satz": "Yarın gelecek ___?", "loesung": "misin", "optionen": ["misin", "musun", "sin"], "de": "Kommst du morgen?" },
        { "art": "hoeren", "vokabel": "w12-zamaninda" },
        { "art": "auswahl_de_tr", "vokabel": "w12-gec-kalmak" },
        { "art": "satzbau", "tr": "Söz veriyorum, geç kalmayacağım.", "de": "Ich verspreche, ich komme nicht zu spät." },
        { "art": "auswahl_tr_de", "vokabel": "w12-asla" },
        { "art": "hoeren", "vokabel": "w12-soz-vermek" },
        { "art": "tippen", "vokabel": "w12-soz" },
        { "art": "satzbau", "tr": "Bilmiyorum, göreceğiz.", "de": "Weiß nicht, mal sehen." }
      ],
      "sprechauftrag": {
        "aufgabe": "Gebt euch gegenseitig drei Versprechen für die nächste Woche auf Türkisch – ernst oder lustig. Und eine Sache, die ihr sicher NICHT machen werdet.",
        "mustersaetze": [
          { "tr": "Her gün Türkçe konuşacağım. Söz!", "de": "Ich spreche jeden Tag Türkisch. Versprochen!" },
          { "tr": "Bulaşıkları sen yıkayacaksın!", "de": "Du wirst abwaschen!" },
          { "tr": "Asla geç kalmayacağım.", "de": "Ich werde nie zu spät kommen." }
        ]
      },
      "alltagssatz": { "tr": "Merak etme!", "de": "Keine Sorge!", "wann": "Wenn Pasha sich heute über irgendetwas Sorgen macht." },
      "merktipp": { "titel": "Mal sehen = Göreceğiz", "text": "Göreceğiz ist die eleganteste Art, sich nicht festzulegen. Perfekt für Fragen wie „Kommt ihr am Wochenende zu uns?“." }
    },
    {
