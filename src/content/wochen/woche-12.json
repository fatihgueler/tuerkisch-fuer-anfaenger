          { "sprecher": "Pasha", "tr": "Denize! Inaya ilk defa denizi görecek.", "de": "Ans Meer! Inaya sieht zum ersten Mal das Meer." },
          { "sprecher": "Sherin", "tr": "Harika! Otelde mi kalacağız?", "de": "Toll! Bleiben wir im Hotel?" },
