        { "id": "w12-kutlamak", "tr": "kutlamak", "de": "feiern / gratulieren", "typ": "wort", "beispiel": { "tr": "Doğum gününü kutlayacağız.", "de": "Wir werden den Geburtstag feiern." } },
        { "id": "w12-hediye", "tr": "hediye", "de": "Geschenk", "typ": "wort", "beispiel": { "tr": "Ona ne hediye alacağız?", "de": "Was schenken wir ihm?" } },
        { "id": "w12-surpriz", "tr": "sürpriz", "de": "Überraschung", "typ": "wort", "beispiel": { "tr": "Bu bir sürpriz, söyleme!", "de": "Das ist eine Überraschung, nichts verraten!" } },
        { "id": "w12-pasta", "tr": "pasta", "de": "Torte", "typ": "wort", "beispiel": { "tr": "Çikolatalı pasta yapacağım.", "de": "Ich mache eine Schokotorte." }, "merktipp": "Achtung: pasta ist im Türkischen die Torte – Nudeln heißen makarna." },
        { "id": "w12-mum", "tr": "mum", "de": "Kerze", "typ": "wort", "beispiel": { "tr": "Pastada beş mum var.", "de": "Auf der Torte sind fünf Kerzen." } },
        { "id": "w12-parti", "tr": "parti", "de": "Party", "typ": "wort", "beispiel": { "tr": "Parti saat kaçta başlayacak?", "de": "Um wie viel Uhr fängt die Party an?" } },
        { "id": "w12-hazirlik", "tr": "hazırlık", "de": "Vorbereitung", "typ": "wort", "beispiel": { "tr": "Hazırlıklar bitti mi?", "de": "Sind die Vorbereitungen fertig?" } }
      ],
      "grammatik": {
        "titel": "Wer macht was? Zukunft mit „wir“",
        "erklaerung": [
          "Für „wir“: -acağız / -eceğiz: yapacağız, kutlayacağız.",
          "Aufgaben verteilen: Ben pastayı yapacağım, sen hediyeyi alacaksın.",
          "Mit Akkusativ, weil es um bestimmte Dinge geht: pastayı, hediyeyi."
        ],
        "beispiele": [
          { "tr": "Doğum gününü kutlayacağız.", "de": "Wir feiern den Geburtstag." },
          { "tr": "Ben pastayı yapacağım, sen hediyeyi alacaksın.", "de": "Ich mache die Torte, du besorgst das Geschenk." },
          { "tr": "Parti saat kaçta başlayacak?", "de": "Um wie viel Uhr fängt die Party an?" }
        ]
      },
      "dialog": {
        "titel": "Elifs Sohn hat Geburtstag",
        "zeilen": [
          { "sprecher": "Sherin", "tr": "Elif bizi davet etti. Oğlu beş yaşında olacak!", "de": "Elif hat uns eingeladen. Ihr Sohn wird fünf!" },
          { "sprecher": "Pasha", "tr": "Ne zaman?", "de": "Wann?" },
          { "sprecher": "Sherin", "tr": "Cumartesi. Parti saat üçte başlayacak.", "de": "Samstag. Die Party fängt um drei an." },
          { "sprecher": "Pasha", "tr": "Ne hediye alacağız?", "de": "Was schenken wir?" },
          { "sprecher": "Sherin", "tr": "Bir kitap. Sen kitabı alacaksın, ben pasta yapacağım.", "de": "Ein Buch. Du besorgst das Buch, ich backe eine Torte." },
          { "sprecher": "Pasha", "tr": "Tamam. Ama pastadan ben de yiyeceğim!", "de": "Okay. Aber ich esse auch von der Torte!" }
        ]
      },
      "uebungen": [
        { "art": "zuordnen", "vokabeln": ["w12-hediye", "w12-surpriz", "w12-pasta", "w12-mum"] },
        { "art": "luecke", "satz": "Doğum gününü kutla___.", "loesung": "yacağız", "optionen": ["yacağız", "acağız", "yacağım"], "de": "Wir feiern den Geburtstag." },
        { "art": "hoeren", "vokabel": "w12-davet-etmek" },
        { "art": "auswahl_de_tr", "vokabel": "w12-kutlamak" },
        { "art": "satzbau", "tr": "Parti saat kaçta başlayacak?", "de": "Um wie viel Uhr fängt die Party an?" },
        { "art": "luecke", "satz": "Sen kitabı ala___.", "loesung": "caksın", "optionen": ["caksın", "cağım", "cak"], "de": "Du besorgst das Buch." },
