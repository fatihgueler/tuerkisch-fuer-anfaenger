          "kopf": ["", "gelmek", "uyumak", "almak"],
          "zeilen": [
            ["ich", "geldim", "uyudum", "aldım"],
            ["du", "geldin", "uyudun", "aldın"],
            ["er/sie", "geldi", "uyudu", "aldı"],
            ["wir", "geldik", "uyuduk", "aldık"]
          ]
        },
        "beispiele": [
          { "tr": "Dün markete gittim.", "de": "Gestern war ich im Supermarkt." },
          { "tr": "Inaya az önce uyudu.", "de": "Inaya ist gerade eingeschlafen." },
          { "tr": "Bugün ne yaptın?", "de": "Was hast du heute gemacht?" }
        ]
      },
      "dialog": {
        "titel": "Feierabend",
        "zeilen": [
          { "sprecher": "Pasha", "tr": "Merhaba canım! Bugün ne yaptın?", "de": "Hallo Schatz! Was hast du heute gemacht?" },
          { "sprecher": "Sherin", "tr": "Sabah parka gittik.", "de": "Morgens waren wir im Park." },
          { "sprecher": "Pasha", "tr": "Nasıldı?", "de": "Wie war's?" },
          { "sprecher": "Sherin", "tr": "Çok güzeldi! Inaya çok güldü.", "de": "Sehr schön! Inaya hat viel gelacht." },
          { "sprecher": "Pasha", "tr": "Şimdi nerede?", "de": "Wo ist sie jetzt?" },
          { "sprecher": "Sherin", "tr": "Az önce uyudu. Sessiz!", "de": "Gerade eingeschlafen. Leise!" }
        ]
      },
      "uebungen": [
        { "art": "zuordnen", "vokabeln": ["w08-dun", "w08-bu-sabah", "w08-gecen-hafta", "w08-az-once"] },
        { "art": "luecke", "satz": "Dün markete git___.", "loesung": "tim", "optionen": ["tim", "dim", "tın"], "de": "Gestern war ich im Supermarkt." },
        { "art": "luecke", "satz": "Inaya az önce uyu___.", "loesung": "du", "optionen": ["du", "dı", "dum"], "de": "Inaya ist gerade eingeschlafen." },
