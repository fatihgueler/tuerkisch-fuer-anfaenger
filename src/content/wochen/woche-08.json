      "sprechauftrag": {
        "aufgabe": "Wenn Pasha heute nach Hause kommt, fragt er „Bugün ne yaptın?“. Erzähl ihm drei Dinge, die du und Inaya heute gemacht habt – in der Vergangenheit.",
        "mustersaetze": [
          { "tr": "Sabah kahvaltı yaptık.", "de": "Morgens haben wir gefrühstückt." },
