      "alltagssatz": { "tr": "Bugün ne yaptın?", "de": "Was hast du heute gemacht?", "wann": "Heute Abend zu Pasha – und dann gut zuhören." },
      "merktipp": { "titel": "Das d-Signal", "text": "Hörst du am Verbende ein -dı/-di/-du/-dü (oder -tı/-ti), ist es vorbei: geldi, gitti, yaptı. Das d ist dein Vergangenheits-Signal." }
    },
