        { "id": "w09-gezmek", "tr": "gezmek", "de": "bummeln / herumfahren", "typ": "wort", "beispiel": { "tr": "Hafta sonu Hannover'de gezdik.", "de": "Am Wochenende sind wir durch Hannover gebummelt." } },
        { "id": "w09-ziyaret-etmek", "tr": "ziyaret etmek", "de": "besuchen", "typ": "chunk", "beispiel": { "tr": "Pazar günü Elif'i ziyaret ettik.", "de": "Am Sonntag haben wir Elif besucht." } },
        { "id": "w09-misafir", "tr": "misafir", "de": "Gast / Besuch", "typ": "wort", "beispiel": { "tr": "Cumartesi misafir geldi.", "de": "Am Samstag kam Besuch." } },
