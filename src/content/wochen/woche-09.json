          { "tr": "Park yeri var mıydı?", "de": "Gab es einen Parkplatz?" }
        ]
      },
      "dialog": {
        "titel": "Samstagseinkauf",
        "zeilen": [
          { "sprecher": "Pasha", "tr": "Market nasıldı?", "de": "Wie war's im Supermarkt?" },
