          { "tr": "Bütün hafta sonu evdeydik.", "de": "Wir waren das ganze Wochenende zu Hause." },
          { "tr": "Harikaydı!", "de": "Es war großartig!" }
        ]
      },
      "dialog": {
        "titel": "Anruf von Schwiegermama",
        "zeilen": [
          { "sprecher": "Pashas Mama", "tr": "Sherin, hafta sonu neredeydiniz? Aradım, cevap yoktu.", "de": "Sherin, wo wart ihr am Wochenende? Ich hab angerufen, keiner ging ran." },
