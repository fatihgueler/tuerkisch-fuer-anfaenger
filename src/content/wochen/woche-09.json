        { "id": "w09-havuz", "tr": "havuz", "de": "Schwimmbad / Pool", "typ": "wort", "beispiel": { "tr": "Havuza gittiniz mi?", "de": "Wart ihr im Schwimmbad?" } },
        { "id": "w09-hayvanat-bahcesi", "tr": "hayvanat bahçesi", "de": "Zoo", "typ": "chunk", "beispiel": { "tr": "Hayvanat bahçesinde filleri gördük.", "de": "Im Zoo haben wir die Elefanten gesehen." } },
