          { "sprecher": "Sherin", "tr": "Harikaydı! Çocuklar çok oynadı.", "de": "Toll! Die Kinder haben viel gespielt." },
          { "sprecher": "Pashas Mama", "tr": "Ya pazar?", "de": "Und Sonntag?" },
          { "sprecher": "Sherin", "tr": "Pazar çok sakindi. Bütün gün evdeydik.", "de": "Sonntag war ganz ruhig. Wir waren den ganzen Tag zu Hause." }
        ]
