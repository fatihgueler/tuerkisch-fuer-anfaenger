      ],
      "grammatik": {
        "titel": "Fragen in der Vergangenheit",
        "erklaerung": [
          "Frage: Verb in der Vergangenheit + mi (eigenes Wort): Gittin mi? = Bist du gegangen?",
          "Die Person steckt hier schon im Verb, mi kommt nur dahinter: gittin mi, gittiniz mi.",
          "„Ihr“ (oder höflich „Sie“) in der Vergangenheit: -dınız / -diniz: gittiniz, yaptınız."
        ],
        "tabelle": {
          "kopf": ["", "Frage"],
          "zeilen": [
            ["du", "Gittin mi?"],
            ["er/sie", "Gitti mi?"],
            ["wir", "Gittik mi?"],
            ["ihr / Sie", "Gittiniz mi?"]
          ]
        },
        "beispiele": [
          { "tr": "Hafta sonu ne yaptınız?", "de": "Was habt ihr am Wochenende gemacht?" },
          { "tr": "Havuza gittiniz mi?", "de": "Wart ihr im Schwimmbad?" },
          { "tr": "Inaya yüzdü mü?", "de": "Ist Inaya geschwommen?" }
        ]
      },
      "dialog": {
        "titel": "Montag auf dem Spielplatz",
        "zeilen": [
          { "sprecher": "Elif", "tr": "Günaydın! Hafta sonu ne yaptınız?", "de": "Guten Morgen! Was habt ihr am Wochenende gemacht?" },
          { "sprecher": "Sherin", "tr": "Cumartesi hayvanat bahçesine gittik.", "de": "Am Samstag waren wir im Zoo." },
          { "sprecher": "Elif", "tr": "Inaya hayvanları sevdi mi?", "de": "Mochte Inaya die Tiere?" },
          { "sprecher": "Sherin", "tr": "Çok sevdi! Ama en çok köpekleri.", "de": "Sehr! Aber am liebsten die Hunde." },
          { "sprecher": "Elif", "tr": "Tabii, evde Amani var!", "de": "Klar, sie hat ja Amani zu Hause!" },
          { "sprecher": "Sherin", "tr": "Pazar günü de dinlendik. Siz ne yaptınız?", "de": "Und Sonntag haben wir uns ausgeruht. Was habt ihr gemacht?" },
          { "sprecher": "Elif", "tr": "Biz havuza gittik. Çok eğlendik!", "de": "Wir waren im Schwimmbad. Hat viel Spaß gemacht!" }
        ]
      },
      "uebungen": [
