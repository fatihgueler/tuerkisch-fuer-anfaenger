          { "sprecher": "Pasha", "tr": "Peki, Inaya ne yaptı?", "de": "Und was hat Inaya gemacht?" },
          { "sprecher": "Sherin", "tr": "Arabada uyudu. Tek iyi haber bu!", "de": "Im Auto geschlafen. Die einzige gute Nachricht!" }
