      "sprechauftrag": {
        "aufgabe": "Erzählt euch gegenseitig euer letztes Wochenende auf Türkisch – als wärt ihr Bekannte, die sich montags treffen. Jeder stellt mindestens drei Fragen mit „… mi?“.",
        "mustersaetze": [
          { "tr": "Hafta sonu ne yaptın?", "de": "Was hast du am Wochenende gemacht?" },
          { "tr": "Cumartesi parka gittik.", "de": "Samstag waren wir im Park." },
          { "tr": "Pazar günü dinlendin mi?", "de": "Hast du dich am Sonntag ausgeruht?" }
        ]
      },
      "alltagssatz": { "tr": "Hafta sonu ne yaptınız?", "de": "Was habt ihr am Wochenende gemacht?", "wann": "Montags – an Elif, die Nachbarn oder beim nächsten Telefonat mit Pashas Familie." },
      "merktipp": { "titel": "mi steht frei", "text": "Bei -yor-Fragen hing die Person an mu (geliyor musun). In der Vergangenheit ist die Person schon im Verb (geldin) – mi steht einfach nackt dahinter: geldin mi?" }
