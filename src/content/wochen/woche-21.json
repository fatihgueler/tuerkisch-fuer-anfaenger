          "typ": "wort",
          "beispiel": {
            "tr": "Türkler çok misafirperverdir.",
            "de": "Türken sind sehr gastfreundlich."
          }
        },
        {
          "id": "w21-ikram-etmek",
          "tr": "ikram etmek",
          "de": "anbieten / bewirten",
          "typ": "chunk",
          "beispiel": {
            "tr": "Misafire önce çay ikram ederiz.",
            "de": "Gästen bieten wir zuerst Tee an."
          }
        }
      ],
      "grammatik": {
        "titel": "Formeln mit Antwort",
        "erklaerung": [
          "Türkische Höflichkeit läuft in Paaren: Wer etwas sagt, bekommt eine feste Antwort.",
          "Hoş geldin(iz)! → Hoş bulduk! (wörtlich: Gut gekommen! → Gut vorgefunden!)",
          "Zu einer Person sen: Hoş geldin! Zu mehreren oder höflich: Hoş geldiniz!"
        ],
        "tabelle": {
          "kopf": [
            "Gastgeber",
            "Gast"
          ],
          "zeilen": [
            [
              "Hoş geldiniz!",
              "Hoş bulduk!"
            ],
            [
              "Buyurun içeri!",
              "Teşekkürler."
            ],
            [
              "Rahatınıza bakın.",
              "Sağ olun."
            ],
            [
              "(Gast:) Size zahmet oldu.",
              "Ne zahmeti!"
            ]
          ]
        },
        "beispiele": [
          {
            "tr": "Hoş geldiniz! – Hoş bulduk!",
            "de": "Willkommen! – Schön, hier zu sein!"
          },
          {
            "tr": "Oturun, rahatınıza bakın.",
            "de": "Setzen Sie sich, machen Sie es sich bequem."
          },
          {
            "tr": "Misafire önce çay ikram ederiz.",
            "de": "Gästen bieten wir zuerst Tee an."
          }
        ]
      },
      "dialog": {
        "titel": "Pashas Mama kommt zu Besuch",
        "zeilen": [
          {
            "sprecher": "Sherin",
            "tr": "Hoş geldiniz! Buyurun içeri!",
            "de": "Herzlich willkommen! Kommt rein!"
          },
          {
            "sprecher": "Pashas Mama",
            "tr": "Hoş bulduk kızım! Torunum nerede?",
            "de": "Schön, hier zu sein, Liebes! Wo ist meine Enkelin?"
          },
          {
            "sprecher": "Sherin",
            "tr": "Salonda, Pasha'yla. Terlik ister misiniz?",
            "de": "Im Wohnzimmer, mit Pasha. Möchtet ihr Hausschuhe?"
          },
          {
            "sprecher": "Pashas Mama",
            "tr": "Sağ ol. Ay, ev ne kadar temiz! Sana çok zahmet oldu.",
            "de": "Danke. Oh, wie sauber die Wohnung ist! Du hast dir so viel Mühe gemacht."
          },
          {
            "sprecher": "Sherin",
            "tr": "Ne zahmeti! Oturun, rahatınıza bakın. Çay demleniyor.",
            "de": "Ach, keine Mühe! Setzt euch, macht es euch bequem. Der Tee zieht schon."
          },
          {
            "sprecher": "Pashas Mama",
            "tr": "Maşallah, tam bir Türk ev sahibi oldun!",
            "de": "Maşallah, du bist eine richtige türkische Gastgeberin geworden!"
          }
        ]
      },
