      "sprechauftrag": {
        "aufgabe": "Begrüßungs-Theater: Pasha klingelt viermal als verschiedene Gäste (seine Mama, Elif, ein Kollege, die Nachbarin). Du empfängst jeden passend – mit sen oder siz.",
        "mustersaetze": [
          {
            "tr": "Hoş geldin! / Hoş geldiniz!",
            "de": "Willkommen! (du / Sie)"
          },
          {
            "tr": "Buyurun içeri, rahatınıza bakın.",
            "de": "Kommen Sie rein, machen Sie es sich bequem."
          },
          {
            "tr": "Ne zahmeti!",
            "de": "Ach, keine Mühe!"
          }
        ]
      },
      "alltagssatz": {
        "tr": "Hoş geldin!",
        "de": "Willkommen (zu Hause)!",
        "wann": "Heute, wenn Pasha nach Hause kommt – er muss mit „Hoş bulduk!“ antworten."
      },
      "merktipp": {
        "titel": "Hoş geldin auch zu Hause",
        "text": "Türkische Familien sagen „Hoş geldin“ auch, wenn jemand einfach von der Arbeit heimkommt. Die Antwort „Hoş bulduk“ kommt automatisch – probier's aus!"
      }
    },
