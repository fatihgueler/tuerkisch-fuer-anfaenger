            "tr": "Hoş geldiniz, buyurun!",
            "de": "Herzlich willkommen, kommen Sie rein!"
          }
        },
        {
          "id": "w21-hos-bulduk",
          "tr": "Hoş bulduk!",
          "de": "Schön, hier zu sein! (Antwort)",
          "typ": "chunk",
          "beispiel": {
            "tr": "Hoş geldiniz! – Hoş bulduk!",
            "de": "Willkommen! – Schön, hier zu sein!"
          }
        },
        {
          "id": "w21-buyurun-iceri",
          "tr": "Buyurun içeri!",
          "de": "Kommen Sie herein!",
          "typ": "chunk",
          "beispiel": {
            "tr": "Kapıda durmayın, buyurun içeri!",
            "de": "Bleiben Sie nicht an der Tür, kommen Sie rein!"
          }
        },
        {
          "id": "w21-terlik",
          "tr": "terlik",
          "de": "Hausschuhe",
          "typ": "wort",
          "beispiel": {
            "tr": "Terlik ister misiniz?",
            "de": "Möchten Sie Hausschuhe?"
          }
        },
        {
          "id": "w21-rahatiniza-bakin",
          "tr": "Rahatınıza bakın.",
          "de": "Machen Sie es sich bequem.",
          "typ": "chunk",
          "beispiel": {
            "tr": "Oturun, rahatınıza bakın.",
            "de": "Setzen Sie sich, machen Sie es sich bequem."
          }
        },
        {
          "id": "w21-zahmet-oldu",
          "tr": "Size zahmet oldu.",
          "de": "Sie haben sich so viel Mühe gemacht.",
          "typ": "chunk",
          "beispiel": {
            "tr": "Ay, size çok zahmet oldu!",
            "de": "Oh, Sie haben sich so viel Mühe gemacht!"
          }
        },
        {
          "id": "w21-ne-zahmeti",
          "tr": "Ne zahmeti!",
          "de": "Ach, keine Mühe!",
          "typ": "chunk",
          "beispiel": {
            "tr": "Ne zahmeti, ne demek!",
            "de": "Ach, keine Mühe, bitte!"
          }
        },
        {
          "id": "w21-misafirperver",
          "tr": "misafirperver",
