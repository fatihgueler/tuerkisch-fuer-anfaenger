          { "sprecher": "Pasha", "tr": "Boğazın da ağrıyor mu?", "de": "Tut dir auch der Hals weh?" },
          { "sprecher": "Sherin", "tr": "Biraz. Ve burnum akıyor.", "de": "Ein bisschen. Und meine Nase läuft." },
          { "sprecher": "Pasha", "tr": "Bugün dinlen. Inaya'ya ben bakıyorum.", "de": "Ruh dich heute aus. Ich kümmere mich um Inaya." },
          { "sprecher": "Sherin", "tr": "Teşekkürler canım.", "de": "Danke, Schatz." }
        ]
      },
      "uebungen": [
        { "art": "zuordnen", "vokabeln": ["w10-bas", "w10-goz", "w10-kulak", "w10-burun", "w10-agiz"] },
