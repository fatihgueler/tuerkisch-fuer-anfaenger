        "beispiele": [
          { "tr": "Başım ağrıyor.", "de": "Ich habe Kopfschmerzen." },
          { "tr": "Inaya'nın kulağı ağrıyor.", "de": "Inaya hat Ohrenschmerzen." },
          { "tr": "Neren ağrıyor?", "de": "Wo tut es dir weh?" }
