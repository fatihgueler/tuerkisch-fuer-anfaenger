      "sprechauftrag": {
        "aufgabe": "Begrüß Pasha heute Abend auf Türkisch und frag, wie es ihm geht. Dann soll er dir einen Satz schnell auf Türkisch sagen – du bittest um Wiederholung, bis du ihn nachsprechen kannst.",
        "mustersaetze": [
          { "tr": "İyi akşamlar, Pasha! Nasılsın?", "de": "Guten Abend, Pasha! Wie geht's dir?" },
          { "tr": "Anlamadım. Tekrar eder misin?", "de": "Hab ich nicht verstanden. Kannst du das wiederholen?" },
          { "tr": "Yavaş konuşur musun?", "de": "Kannst du langsam sprechen?" }
        ]
      },
      "alltagssatz": {
        "tr": "Teşekkür ederim!",
        "de": "Danke schön!",
        "wann": "Jedes Mal, wenn Pasha dir heute etwas reicht – Tee, Inayas Schnuller oder die Fernbedienung."
      },
      "merktipp": {
        "titel": "Vorlesen kannst du schon",
        "text": "Türkisch ist eine Lautschrift: Was du liest, sprichst du. Sobald c, ç und ş sitzen, kannst du jedes Wort vorlesen – auch eins, das du noch nie gesehen hast."
      }
