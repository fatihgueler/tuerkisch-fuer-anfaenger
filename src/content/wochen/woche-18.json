            "sprecher": "Elif",
            "tr": "Bilmiyorum … Uzatıyorum ama uçları çok kötü.",
            "de": "Weiß nicht … Ich lasse sie wachsen, aber die Spitzen sind total kaputt."
          },
          {
            "sprecher": "Sherin",
            "tr": "O zaman sadece uçlarını alayım. Bir de hafif katlı kesim?",
            "de": "Dann schneide ich nur die Spitzen. Und einen leichten Stufenschnitt?"
          },
          {
            "sprecher": "Elif",
            "tr": "Kâkül de yapar mısın?",
            "de": "Machst du auch einen Pony?"
          },
          {
            "sprecher": "Sherin",
            "tr": "Bence kâkül sana çok yakışır. Ama önce makasımı bulayım!",
            "de": "Ich finde, ein Pony würde dir super stehen. Aber erst muss ich meine Schere finden!"
          },
          {
            "sprecher": "Elif",
            "tr": "Sonra fön de çeker misin?",
            "de": "Föhnst du danach auch?"
          },
          {
            "sprecher": "Sherin",
            "tr": "Tabii! Salondaki gibi.",
            "de": "Klar! Wie im Salon."
          }
        ]
